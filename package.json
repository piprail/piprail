{
  "name": "piprail",
  "private": true,
  "version": "0.0.0",
  "description": "PipRail monorepo — the @piprail/sdk + landing/docs site. Pure OSS, no fee, pay straight to your wallet.",
  "type": "module",
  "workspaces": [
    "sdk",
    "site",
    "mcp",
    "docs",
    "create-piprail"
  ],
  "scripts": {
    "dev": "npm run dev -w @piprail/site",
    "dev:docs": "npm run dev -w @piprail/docs",
    "build": "npm run build -w @piprail/site",
    "build:sdk": "npm run build -w @piprail/sdk",
    "build:mcp": "npm run build -w @piprail/mcp",
    "build:docs": "npm run build -w @piprail/docs",
    "test:sdk": "npm test -w @piprail/sdk",
    "test:mcp": "npm test -w @piprail/mcp",
    "typecheck": "npm run typecheck -w @piprail/sdk && npm run typecheck -w @piprail/mcp",
    "sync": "node scripts/sync/check.mjs",
    "verify-gate": "node scripts/verify-gate.mjs",
    "test:linkedin": "node --test \".claude/skills/linkedin/tests/*.test.mjs\" \".claude/skills/linkedin-page/tests/*.test.mjs\"",
    "post": "node .claude/skills/linkedin/scripts/draft.mjs",
    "post:check": "node .claude/skills/linkedin/scripts/draft.mjs check",
    "post:route": "node .claude/skills/linkedin-page/scripts/channel.mjs route",
    "post:vet": "node .claude/skills/linkedin-page/scripts/channel.mjs vet",
    "brand:linkedin": "node .claude/skills/branding/design/social/profile/render-linkedin.mjs",
    "test:x": "node --test \".claude/skills/x-api/tests/*.test.mjs\"",
    "x": "node .claude/skills/x-api/scripts/x.mjs",
    "x:check": "node .claude/skills/x-api/scripts/x.mjs check",
    "x:doctor": "node .claude/skills/x-api/scripts/x.mjs doctor"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "vite": "^7.3.2"
  },
  "comments": {
    "overrides": "Astro 6 (site + docs) and @tailwindcss/vite need Vite 7 (the Tailwind plugin calls Vite 6+'s createIdResolver). vitest@2 (sdk/mcp) hard-pins Vite 5. So: force Vite 7 at the root, and scope the vitest toolchain (vitest / vite-node / @vitest/mocker) back to its own nested Vite 5 — the SDK/MCP test gate is untouched. Revisit (drop these) if vitest is bumped to v3 (Vite 7-native)."
  },
  "overrides": {
    "vite": "^7.3.2",
    "vitest": {
      "vite": "^5.0.0"
    },
    "vite-node": {
      "vite": "^5.0.0"
    },
    "@vitest/mocker": {
      "vite": "^5.0.0"
    }
  }
}
