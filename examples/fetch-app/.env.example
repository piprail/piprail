# examples/fetch-app — copy to .env (gitignored). NEVER commit a real key.

# ── PAYER (the @piprail/mcp budget-bound wallet the bridge drives) ──────────────
# A funded key on PIPRAIL_CHAIN. The MCP enforces the spend policy below; the model
# (here, the payer agent) literally cannot overspend it.
PIPRAIL_PRIVATE_KEY=0xYOUR_PAYER_KEY
PIPRAIL_CHAIN=bnb
PIPRAIL_MAX_AMOUNT=0.10        # per payment
PIPRAIL_MAX_TOTAL=5.00         # lifetime, per token
PIPRAIL_TOKENS=FDUSD,USD1,USDC,USDT
# Pay standard `exact` servers too (gasless buyer). onchain-proof is always on:
PIPRAIL_SCHEMES=onchain-proof,exact
# PIPRAIL_RPC_URL=https://your-bnb-rpc   # optional custom RPC

# ── PAYEE (the PipRail gate — merchant.mjs — the x402 resource) ─────────────────
PAY_TO=0xYOUR_PAYEE_WALLET     # where the payment lands (verified locally)
MERCHANT_PORT=4021
MERCHANT_TOKEN=FDUSD           # FDUSD/USD1 on BNB = gasless EIP-3009; USDC/USDT = Permit2
MERCHANT_AMOUNT=0.05
# MERCHANT_PUBLIC_URL=http://127.0.0.1:4021   # how the payer reaches the gate
# Make the payment GASLESS FOR BOTH SIDES — a facilitator broadcasts the signed auth
# (e.g. Binance x402 on BNB). Without it, the gate offers onchain-proof (payer pays gas):
# MERCHANT_FACILITATOR=https://facilitator.example/bnb

# ── AGENT WIRING ───────────────────────────────────────────────────────────────
# The payer agent prints its address on startup; paste it here for the payee.
PAYER_ADDRESS=agent1q...
MERCHANT_OFFER=http://127.0.0.1:4021/offer
# PAYER_SEED / PAYEE_SEED — override the demo seeds for stable agent addresses.
