# examples/agentverse-agent — copy to .env (gitignored). NEVER commit a real key.

# ── EARN: the relay's fee gate (where callers pay to use it) ────────────────────
PAY_TO=0xYourFeeWallet         # receives the service fee (verified locally; your wallet)
RELAY_GATE_CHAIN=bnb           # the chain the fee is charged on
RELAY_GATE_TOKEN=USDC
RELAY_FEE=0.02                 # service fee — set ABOVE your expected target cost
# RELAY_GATE_RPC=https://your-bnb-rpc

# ── SPEND: the relay's budget-bound wallet (pays targets for the caller) ────────
RELAY_PRIVATE_KEY=0xYourSpendKey   # funded on RELAY_PAYER_CHAIN; capped by the policy below
RELAY_PAYER_CHAIN=base             # chain it pays target x402 URLs on
RELAY_MAX_AMOUNT=0.05              # per downstream call
RELAY_MAX_TOTAL=5.00               # lifetime, per token
# RELAY_PAYER_RPC=https://your-base-rpc

# Only pay endpoints on these hosts (comma-separated). Never an open relay.
RELAY_ALLOW_HOSTS=piprail.com

# ── DUAL-RAIL earn (payable by ANY x402 client) ────────────────────────────────
# The gate advertises the standard `exact` rail beside onchain-proof by default, so
# every x402 client can pay it. It self-settles with the relayer key below (defaults
# to RELAY_PRIVATE_KEY) — the method (EIP-3009 vs Permit2) is auto-selected per token.
# RELAY_EXACT=0                                  # disable exact (e.g. a non-EVM gate chain)
# RELAY_RELAYER_KEY=0x...                        # gas-paying settle key (default: RELAY_PRIVATE_KEY)
# RELAY_GATE_FACILITATOR=https://facilitator...  # settle via a facilitator instead of self-settle

# ── PUBLIC reachability (for Agentverse registration) ──────────────────────────
RELAY_PORT=4031
RELAY_PUBLIC_URL=https://your-relay.example.com   # where relay.mjs is deployed

# ── Agentverse registration (register.py) ──────────────────────────────────────
AGENTVERSE_KEY=YOUR_AGENTVERSE_API_KEY
AGENT_SECRET_KEY=YOUR_RANDOM_SECRET_SEED          # derives the agent identity; keep in .secrets
