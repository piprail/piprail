{
  "name": "@piprail/sdk",
  "version": "1.10.0",
  "description": "Accept x402 crypto payments across 29 chains — every major EVM chain plus Solana, TON, Tron, NEAR, Sui, Aptos, Algorand, Stellar & XRPL — in a couple of lines. No backend, no database, no fee; payments settle straight to your wallet.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHAINS.md",
    "ERRORS.md",
    "STANDARDS.md",
    "DISCOVERY.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "prepublishOnly": "npm run build && npm test && npm run typecheck && npm run typecheck:test"
  },
  "keywords": [
    "piprail",
    "x402",
    "402",
    "payment-required",
    "multichain",
    "evm",
    "solana",
    "ton",
    "tron",
    "near",
    "sui",
    "aptos",
    "algorand",
    "stellar",
    "xrpl",
    "base",
    "bnb-chain",
    "ethereum",
    "usdc",
    "usdt",
    "stablecoin",
    "crypto-payments",
    "agent-payments",
    "ai-agent",
    "express-middleware",
    "payment-middleware"
  ],
  "author": "PipRail",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piprail/piprail.git",
    "directory": "sdk"
  },
  "homepage": "https://piprail.com",
  "bugs": "https://github.com/piprail/piprail/issues",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@aptos-labs/ts-sdk": ">=2 <8",
    "@mysten/sui": ">=2 <3",
    "@solana/spl-token": "^0.4.0",
    "@solana/web3.js": "^1.95.0",
    "@stellar/stellar-sdk": ">=13 <16",
    "@ton/core": ">=0.59 <1",
    "@ton/crypto": ">=3 <4",
    "@ton/ton": ">=15 <17",
    "algosdk": ">=3 <4",
    "bs58": "^5.0.0",
    "near-api-js": ">=7 <8",
    "tronweb": ">=6 <7",
    "viem": "^2.21.0",
    "xrpl": ">=4 <5"
  },
  "peerDependenciesMeta": {
    "@aptos-labs/ts-sdk": {
      "optional": true
    },
    "@solana/web3.js": {
      "optional": true
    },
    "@solana/spl-token": {
      "optional": true
    },
    "@stellar/stellar-sdk": {
      "optional": true
    },
    "bs58": {
      "optional": true
    },
    "@ton/ton": {
      "optional": true
    },
    "@ton/core": {
      "optional": true
    },
    "@ton/crypto": {
      "optional": true
    },
    "xrpl": {
      "optional": true
    },
    "tronweb": {
      "optional": true
    },
    "@mysten/sui": {
      "optional": true
    },
    "near-api-js": {
      "optional": true
    },
    "algosdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aptos-labs/ts-sdk": "^7.1.0",
    "@mysten/sui": "^2.17.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "@stellar/stellar-sdk": "^15.1.0",
    "@ton/core": "^0.63.1",
    "@ton/crypto": "^3.3.0",
    "@ton/ton": "^16.2.4",
    "@types/node": "^22.10.0",
    "algosdk": "^3.5.2",
    "bs58": "^5.0.0",
    "near-api-js": "^7.2.0",
    "tronweb": "^6.3.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "viem": "^2.51.2",
    "vitest": "^2.1.8",
    "xrpl": "^4.6.0"
  }
}
