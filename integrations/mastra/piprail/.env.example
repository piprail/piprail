# PipRail × Mastra — copy to `.env` and fill in. NEVER commit the real .env.
#
# Read-only first run: leave PIPRAIL_PRIVATE_KEY blank and the agent can still
# discover / quote / plan / budget / guide. Only paying needs a funded wallet key.

# Self-custodial wallet key/seed — EVM 0x…, Solana base58, or a mnemonic. NOT an API key.
PIPRAIL_PRIVATE_KEY=

# Chain to pay on — any EVM, or solana/ton/tron/near/sui/aptos/algorand/stellar/xrpl.
PIPRAIL_CHAIN=base

# The spend wall the model cannot exceed.
PIPRAIL_MAX_AMOUNT=0.10   # max per payment, in the token's units (≈ $ for USDC)
PIPRAIL_MAX_TOTAL=5.00    # lifetime budget per token
PIPRAIL_TOKENS=USDC       # allowed tokens, comma-separated

# Optional: custom RPC (recommended in production), and add `exact` to also pay standard x402 servers.
# PIPRAIL_RPC_URL=
# PIPRAIL_SCHEMES=onchain-proof,exact

# The example agent uses OpenAI as its LLM (swap for any Vercel AI SDK provider).
OPENAI_API_KEY=
