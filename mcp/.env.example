# @piprail/mcp — copy to .env (gitignored) or paste into your MCP client's "env" block.
# REQUIRED — your wallet key/seed for the chosen chain. NEVER commit a real key.
PIPRAIL_PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# Optional (defaults shown):
PIPRAIL_CHAIN=base
PIPRAIL_MAX_AMOUNT=0.10
PIPRAIL_MAX_TOTAL=10.00
PIPRAIL_TOKENS=USDC          # symbols (USDC,USDT,…) + the alias `native` for the chain's coin; auto-defaults to USDT on Tron & TON

# Payment schemes to settle. Default = onchain-proof only (PipRail's backendless rail).
# Add `exact` to ALSO pay standard x402 servers — EVM + EIP-3009 (USDC) only:
# PIPRAIL_SCHEMES=onchain-proof,exact
# Add `upto` to also pay metered x402 servers on EVM (Permit2): sign a MAX, the
# server settles the actual <= max:
# PIPRAIL_SCHEMES=onchain-proof,exact,upto

# PIPRAIL_HOSTS=api.example.com,*.trusted.com
# PIPRAIL_ALLOW_UNKNOWN_TOKENS=false

# ── Time envelope (Mode A: the budget is also a CLOCK) ──────────────────────────
# A session TTL in seconds — after it elapses, EVERY payment is refused (TERMINAL;
# restart the server or raise the TTL). In-memory: a restart begins a fresh window.
# PIPRAIL_TTL=3600
# An optional rolling rate-limit, per (network, asset). windowTotal needs windowSeconds.
# PIPRAIL_WINDOW_TOTAL=1.00
# PIPRAIL_WINDOW_SECONDS=3600

# ── Cross-token GRAND TOTAL + payment-count caps (one budget across everything) ──
# Cap total spend per DENOMINATION across every stablecoin AND chain — "$20 total,
# full stop". USDC/USDT/USD1/FDUSD/RLUSD = USD; EURC = EUR. NOT a price oracle (a
# unit-of-account sum, each token 1:1; native coins are excluded). In multi-chain
# mode the chains share one ledger, so this spans them all.
# PIPRAIL_MAX_TOTAL_DENOM=USD:20.00,EUR:5.00
# Cap the NUMBER of payments (across every chain + token):
# PIPRAIL_MAX_PAYMENTS=100
# …and within the rolling window (set PIPRAIL_WINDOW_SECONDS too):
# PIPRAIL_MAX_PAYMENTS_PER_WINDOW=10
# Early warning: emit a budget-threshold event when spend crosses this fraction of
# any cap (needs PIPRAIL_EVENT_LOG to be visible):
# PIPRAIL_WARN_AT_FRACTION=0.8

# ── Durable budget + operator event sink (no backend; you own the files) ────────
# Persist the budget to a local log so it SURVIVES a restart (caps resume):
# PIPRAIL_SPEND_LOG=/data/piprail-spend.jsonl
# Mirror every payment event (settled / declined / budget-threshold) as one-line
# JSON to stderr or a file — your notification stream (stdout stays the protocol):
# PIPRAIL_EVENT_LOG=stderr

# ── Ask-before-pay (Mode B: supervised clients like Claude Desktop / Cursor) ────
# Ask the human to approve each payment via MCP elicitation. Default off = Mode A
# (the spend policy IS the consent). Silently no-ops on clients that can't elicit.
# Decline / cancel / timeout / transport-drop all fail-safe to NOT paying.
# PIPRAIL_CONFIRM=1
# Tune the approval window (ms). Default 55000 — MUST stay below your MCP client's
# request timeout (typically 60000) so a decline reaches the agent cleanly.
# PIPRAIL_CONFIRM_TIMEOUT_MS=55000

# ── Agent guide (default ON) ───────────────────────────────────────────────────
# Exposes the PipRail agent contract as an MCP prompt (piprail_agent_guide) + a
# piprail://guide resource, plus a live piprail://budget resource. Off for minimal clients:
# PIPRAIL_GUIDE=0

# Custom RPC — fold any API key INTO the URL (the SDK has no separate key field):
# PIPRAIL_RPC_URL=https://your-rpc-endpoint
#   TON needs a keyed RPC:  https://toncenter.com/api/v2/jsonRPC?api_key=YOUR_KEY
#   Tron's public RPC is rate-limited — use your own, and keep TRX in the wallet for gas.

# Only for chain=near:
# PIPRAIL_NEAR_ACCOUNT_ID=you.near
