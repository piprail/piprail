# ─────────────────────────────────────────────────────────────────────────────
# PipRail — operational credentials.  COPY TO `.env` AND FILL IN.
#
#     cp .env.example .env && chmod 600 .env
#
# `.env` is gitignored; THIS file is tracked and must never contain a real value.
# Everything is loaded by `scripts/load-env.mjs` (one parser, one file).
#
# ⚠️ NONE of this is needed to USE PipRail. `@piprail/sdk` and `@piprail/mcp` take
# their config from the caller — see `mcp/.env.example` and `site/.env.example`
# for the PRODUCT's own env surface. This file is the maintainer's ops toolbox:
# SEO measurement and the live mainnet audits.
# ─────────────────────────────────────────────────────────────────────────────


# ═══ SEO / measurement ═══════════════════════════════════════════════════════

# DataForSEO — PAID, billed per query. Ranks, SERPs, backlinks, keyword volume.
# Get: dataforseo.com -> API dashboard. Used by: `dataforseo` skill.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Bing Webmaster Tools — free. Inbound links, queries, crawl health, URL submission
# (100/day). 🔴 The key is per-ACCOUNT, not per-site: it is shared with the sister
# sites, so rotating it here rotates it for all of them.
# Get: bing.com/webmasters -> Settings -> API access. Used by: `analytics` skill.
BING_WEBMASTER_API_KEY=


# ═══ Chain RPC endpoints ═════════════════════════════════════════════════════
# Only endpoints that need an API key, or that replace a shipped default which is
# unreliable in practice. Every chain additionally honours an ad-hoc `RPC_<CHAIN>`
# (RPC_BASE, RPC_SOLANA, …) if you want to override one for a single run.

# TON — the keyless toncenter endpoint 429s under load. The SDK keys toncenter via
# the URL, so the api_key rides INSIDE this value:
#   RPC_TON=https://toncenter.com/api/v2/jsonRPC?api_key=<key>
# Get: t.me/tonapibot. Required for the TON leg of the live audit.
RPC_TON=

# Tron — `api.trongrid.io` (the SDK's shipped default) serves reads fine, but its
# free tier returns 429 during the PAY flow (broadcast + confirm-poll + the
# solidity-node verify scan). Verified working, no key needed:
#   RPC_TRON=https://tron-rpc.publicnode.com     (or https://api.tronstack.io)
RPC_TRON=


# ═══ EMAIL + REGISTRAR — outreach ════════════════════════════════════════════
# Read by the `spacemail` (transport), `outreach` (campaign) and `spaceship`
# (registrar) skills. All optional: the SDK, the site and the docs never touch
# them, and every script degrades with a clear message when they are unset.

# The registrar API. ONE key covers every domain on the Spaceship account, so
# `.claude/skills/spaceship/scripts/spaceship.mjs` reads this file FIRST and falls
# back to the shared network file at ~/Sites/games/deploy/deploy.env.
# Get: https://www.spaceship.com/application/api-manager/ → "New API key".
# Scopes needed: domains read, DNS read/write.
SPACESHIP_API_KEY=
SPACESHIP_API_SECRET=

# The Netlify personal access token. Netlify DNS (NS1) is the AUTHORITATIVE zone for
# piprail.com, so this is what publishes the mail records:
#   node .claude/skills/spacemail/scripts/dns-publish.mjs [--commit]
# 🔴 Account-wide. It can redeploy every site on the account, not just this zone.
# Get: https://app.netlify.com/user/applications#personal-access-tokens
NETLIFY_AUTH_TOKEN=

# The outreach mailbox — john@piprail.com on SPACEMAIL, created 2026-08-29.
# Hosts and ports probed live. 🔴 SMTP_PASSWORD is the ordinary WEBMAIL password:
# Spacemail issues no app passwords, so this value IS the mailbox. Only John has it.
# IMAP_* fall back to the SMTP pair, because one password serves both protocols.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
IMAP_HOST=
IMAP_PORT=
MAIL_FROM_ADDRESS=
OUTREACH_FROM_NAME=

# ═══ NOT IN THIS FILE — and deliberately so ══════════════════════════════════
# Two credential stores stay outside `.env` because flattening them would make
# things worse. This section exists so "where is everything?" still has ONE answer.
#
# 1. TEST WALLETS — `.secrets/wallets/<family>-wallet.json`  (gitignored, chmod 600)
#    One file per chain family, each holding a payer AND a recoverable merchant
#    (address + secret + role) as STRUCTURED JSON, read by name by the audit
#    harnesses. Flattening ~12 families x 2 roles into flat vars would lose the
#    structure, break every consumer, and put every chain's key in one blast radius.
#    Funding + provisioning: the `wallet-audit` and `live-smoke-test` skills.
#
# 2. GOOGLE OAUTH (GSC + GA4) — `~/.config/gcp/<project>-oauth.json`
#    A Google-issued OAuth token file, machine-level and shared with the sister
#    sites, held OUTSIDE the repo entirely. Owner OAuth is used because the GA4/GSC
#    "add user" flow rejects service accounts. Details: the `analytics` skill.
#
# Neither is a key=value secret, so neither belongs here — but both are yours.
