# ─────────────────────────────────────────────────────────────────────────────
# PipRail — operational credentials.  COPY TO `.env` AND FILL IN.
#
#     cp .env.example .env && chmod 600 .env
#
# `.env` is gitignored; THIS file is tracked and must never contain a real value.
# Everything is loaded by `scripts/load-env.mjs` (one parser, one file).
#
# ⚠️ NONE of this is needed to USE PipRail. `@piprail/sdk` and `@piprail/mcp` take
# their config from the caller — see `mcp/.env.example` and `site/.env.example`
# for the PRODUCT's own env surface. This file is the maintainer's ops toolbox:
# SEO measurement and the live mainnet audits.
# ─────────────────────────────────────────────────────────────────────────────


# ═══ SEO / measurement ═══════════════════════════════════════════════════════

# DataForSEO — PAID, billed per query. Ranks, SERPs, backlinks, keyword volume.
# Get: dataforseo.com -> API dashboard. Used by: `dataforseo` skill.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Bing Webmaster Tools — free. Inbound links, queries, crawl health, URL submission
# (100/day). 🔴 The key is per-ACCOUNT, not per-site: it is shared with the sister
# sites, so rotating it here rotates it for all of them.
# Get: bing.com/webmasters -> Settings -> API access. Used by: `analytics` skill.
BING_WEBMASTER_API_KEY=


# ═══ Chain RPC endpoints ═════════════════════════════════════════════════════
# Only endpoints that need an API key, or that replace a shipped default which is
# unreliable in practice. Every chain additionally honours an ad-hoc `RPC_<CHAIN>`
# (RPC_BASE, RPC_SOLANA, …) if you want to override one for a single run.

# TON — the keyless toncenter endpoint 429s under load. The SDK keys toncenter via
# the URL, so the api_key rides INSIDE this value:
#   RPC_TON=https://toncenter.com/api/v2/jsonRPC?api_key=<key>
# Get: t.me/tonapibot. Required for the TON leg of the live audit.
RPC_TON=

# Tron — `api.trongrid.io` (the SDK's shipped default) serves reads fine, but its
# free tier returns 429 during the PAY flow (broadcast + confirm-poll + the
# solidity-node verify scan). Verified working, no key needed:
#   RPC_TRON=https://tron-rpc.publicnode.com     (or https://api.tronstack.io)
RPC_TRON=


# ═══ EMAIL + REGISTRAR — outreach ════════════════════════════════════════════
# Read by the `spacemail` (transport), `outreach` (campaign) and `spaceship`
# (registrar) skills. All optional: the SDK, the site and the docs never touch
# them, and every script degrades with a clear message when they are unset.

# The registrar API. ONE key covers every domain on the Spaceship account, so
# `.claude/skills/spaceship/scripts/spaceship.mjs` reads this file FIRST and falls
# back to the shared network file at ~/Sites/games/deploy/deploy.env.
# Get: https://www.spaceship.com/application/api-manager/ → "New API key".
# Scopes needed: domains read, DNS read/write.
SPACESHIP_API_KEY=
SPACESHIP_API_SECRET=

# The Netlify personal access token. Netlify DNS (NS1) is the AUTHORITATIVE zone for
# piprail.com, so this is what publishes the mail records:
#   node .claude/skills/spacemail/scripts/dns-publish.mjs [--commit]
# 🔴 Account-wide. It can redeploy every site on the account, not just this zone.
# Get: https://app.netlify.com/user/applications#personal-access-tokens
NETLIFY_AUTH_TOKEN=

# The outreach mailbox — john@piprail.com on SPACEMAIL, created 2026-08-29.
# Hosts and ports probed live. 🔴 SMTP_PASSWORD is the ordinary WEBMAIL password:
# Spacemail issues no app passwords, so this value IS the mailbox. Only John has it.
# IMAP_* fall back to the SMTP pair, because one password serves both protocols.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
IMAP_HOST=
IMAP_PORT=
MAIL_FROM_ADDRESS=
OUTREACH_FROM_NAME=

# ── LinkedIn (the `linkedin` + `linkedin-page` skills) ───────────────────────
# Publishing to John's PERSONAL LinkedIn feed over the official API. Company-page
# posting is NOT possible on a self-serve app (w_organization_social is partner-gated),
# so nothing here can post as the PipRail page.
#
# 🔴 THERE IS NO LINKEDIN PASSWORD VARIABLE, AND THERE NEVER WILL BE. LinkedIn's API
# is OAuth-only: there is no password grant and no endpoint that accepts a member
# password. Any tool asking for one is driving a logged-in browser session, which
# breaks LinkedIn's User Agreement and gets accounts restricted. The name is on a
# blocklist in .claude/skills/linkedin/scripts/lib/env.mjs, dropped at parse time.
#
# Get the first two: https://www.linkedin.com/developers/apps -> your app -> Auth tab.
# Setup, click by click: .claude/skills/linkedin/SETUP.md
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Paste a token from the Developer Portal's token generator, then run
#   node .claude/skills/linkedin/scripts/auth.mjs import
# 🔴 The token lives 60 days and CANNOT be refreshed programmatically (refresh tokens
# go to approved partners only). `auth.mjs status` prints the days remaining.
LINKEDIN_ACCESS_TOKEN=
# The LinkedIn REST API version, YYYYMM. Required on every /rest/* call; a sunset
# value is a hard error, never a silent fallback to latest. Leave EMPTY to use the
# code default (see scripts/lib/api.mjs); set it only to pin an older one. Bump
# roughly annually: versions are supported about twelve months.
LINKEDIN_API_VERSION=
# The OAuth redirect URL, which must match the one registered on the app's Auth tab
# CHARACTER FOR CHARACTER, trailing slash included. Only needed for the full OAuth
# flow (auth.mjs url/exchange); the Developer Portal token generator skips it.
LINKEDIN_REDIRECT_URI=
# The scopes requested at authorization, space separated. Defaults to the four
# self-serve ones. 🔴 Changing this set silently invalidates every existing token.
LINKEDIN_SCOPES=
# ── Two switches that are NOT credentials, documented so the map stays complete ──
# Simulates an unconfigured repo so the suite never depends on whether this machine
# happens to be authenticated. Set to 1 in tests only; leave empty here.
LINKEDIN_SKIP_DOTENV=
# Where the exchanged token is cached. Defaults to <repo>/.linkedin-token.json, which is
# gitignored and denied to the Read tool. Override only in tests.
LINKEDIN_TOKEN_PATH=

# ── Zapier (posts AS the LinkedIn company page) ─────────────────────────────
#
# A free Zapier account owned by the project. Its one job is a two-step Zap:
# RSS by Zapier (https://piprail.com/linkedin-page.xml) -> LinkedIn "Create
# Company Update", which is how posts reach linkedin.com/company/piprail without
# a partnership application (LinkedIn's Community Management API is for legal
# entities only). Runbook: .claude/skills/linkedin-page/ZAPIER.md
# Account created 2026-09-06 with the project mailbox. The password was generated
# by the tooling and written here directly; it was never printed.
ZAPIER_EMAIL=
ZAPIER_PASSWORD=

# ── X / Twitter (the `x-api` skill) ─────────────────────────────────────────
# Publishing to @piprailhq over the official v2 API from this machine.
#
# 🔴 THERE IS NO FREE TIER. X killed Free/Basic/Pro on 6 February 2026. Every
# post is billed: $0.015, or $0.200 if the TEXT contains a URL. Buy credits and
# set a spending cap at https://console.x.com. Our own house rule (no raw URL in
# the body, RULES.md §4) keeps every post at the cheap rate.
#
# 🔴 THERE IS NO X PASSWORD VARIABLE AND THERE NEVER WILL BE. X's API is
# OAuth-only. The name is on a blocklist in
# .claude/skills/x-api/scripts/lib/env.mjs and dropped at parse time.
#
# Account identifiers for the `x-browser` skill (a logged-in browser session, not the
# API). Both are NON-secret: the handle is public and the email is only recorded so the
# right account is recognised. The login itself is cookies in Playwright MCP's persistent
# browser profile, established once by hand; there is still no password variable.
# X_USERNAME is the handle, piprailhq. X_ACCOUNT_EMAIL is the address the account is
# registered under (John knows it; it was never given to the tooling).
X_USERNAME=
X_ACCOUNT_EMAIL=
#
# The app is a PUBLIC client using PKCE, so there is a client id and NO secret.
# Setup, click by click: .claude/skills/x-api/SETUP.md
X_CLIENT_ID=
# Must match the Callback URI registered on the app, character for character.
# Defaults to https://piprail.com/auth/x/callback when empty.
X_REDIRECT_URI=
# Where the token pair is cached. Defaults to <repo>/.x-token.json, which is
# gitignored and denied to the Read tool. Override only in tests.
# 🔴 The access token lives 2 HOURS and the refresh token is SINGLE USE, so this
# file is rewritten constantly, and atomically. See scripts/lib/token.mjs.
X_TOKEN_PATH=
# Simulates an unconfigured repo so the suite never depends on whether this
# machine is authenticated, and never makes a BILLED call. Tests only.
X_SKIP_DOTENV=

# ═══ NOT IN THIS FILE — and deliberately so ══════════════════════════════════
# Two credential stores stay outside `.env` because flattening them would make
# things worse. This section exists so "where is everything?" still has ONE answer.
#
# 1. TEST WALLETS — `.secrets/wallets/<family>-wallet.json`  (gitignored, chmod 600)
#    One file per chain family, each holding a payer AND a recoverable merchant
#    (address + secret + role) as STRUCTURED JSON, read by name by the audit
#    harnesses. Flattening ~12 families x 2 roles into flat vars would lose the
#    structure, break every consumer, and put every chain's key in one blast radius.
#    Funding + provisioning: the `wallet-audit` and `live-smoke-test` skills.
#
# 2. GOOGLE OAUTH (GSC + GA4) — `~/.config/gcp/<project>-oauth.json`
#    A Google-issued OAuth token file, machine-level and shared with the sister
#    sites, held OUTSIDE the repo entirely. Owner OAuth is used because the GA4/GSC
#    "add user" flow rejects service accounts. Details: the `analytics` skill.
#
# Neither is a key=value secret, so neither belongs here — but both are yours.
