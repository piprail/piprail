# Local-only mainnet test scripts (read keys from external .secrets at runtime)
examples/*.local.mjs
mcp/*.local.mjs

# Playwright MCP scratch (screenshots / snapshots) — local only
.playwright-mcp/

# Local-only secret store (wallet mnemonic + private key). NEVER commit.
.secrets/

# Root build/scratch outputs (Foundry leftovers, packed tarballs, etc.)
/out/
/cache/

# Design asset backups — kept local. (Design masters now live with the skill at
# /.claude/skills/site-design/design/, already covered by /.claude/ below.)
/site/asset-backups/

# Local agent workspace. DEFAULT = PRIVATE: everything under .claude/ stays local
# (wallet-audit outputs with test-wallet addresses+balances, third-party outreach
# contacts, internal strategy/plans, ~294MB of node_modules, settings, the README index).
# We ship ONLY an explicit allowlist of audited, contributor-facing material below.
# To publish a NEW skill `foo`: add `!/.claude/skills/foo/`. See .claude/README.md.
# (CLAUDE.md is committed as the public project guide; AGENTS.md is the agent-facing one.)
/.claude/*
!/.claude/commands/
!/.claude/skills/
/.claude/skills/*
!/.claude/skills/add-chain-integration/
!/.claude/skills/site-design/
!/.claude/skills/release/
!/.claude/skills/verify-gate/

# Stray local screenshots
screencapture-*.png
Screenshot*.png

# Research & design notes now live under /.claude/ (already ignored above) — local only.

# Design-skill EXPORTS = local render/staging outputs (social cards, slide masters,
# promo videos). The skill itself, its design/source/ masters, and the brand assets
# already committed in here stay tracked; this only keeps NEW local renders out of
# git so the repo never bloats. Commit a new design asset deliberately via `git add -f`.
.claude/skills/site-design/design/exports/

# Design-skill VIDEO pipeline (was the root .video-build/) — the SOURCE is tracked
# (scene/card HTML, render *.mjs, synth.py, README), but the GENERATED renders are not:
# assets.js (data-URI bundle), the synthesized audio, frame dumps, and any PNG/MP4 output.
.claude/skills/site-design/design/video/assets.js
.claude/skills/site-design/design/video/wave.png
.claude/skills/site-design/design/video/music.wav
.claude/skills/site-design/design/video/frames/
.claude/skills/site-design/design/video/sample/
.claude/skills/site-design/design/video/*.png
.claude/skills/site-design/design/video/*.mp4
.claude/skills/site-design/design/video/*.wav
.claude/skills/site-design/design/video/*.mp3
.claude/skills/site-design/design/video/__pycache__/
