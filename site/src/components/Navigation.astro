---
// Shared top navigation — sticky, translucent, used on every page for consistency.
// `path` highlights the active link (e.g. the Demo pill on /demo). At tablet and
// below (< lg) the secondary links collapse into a hamburger that opens a
// full-height slide-in overlay (backdrop + right panel). CSS does the slide
// (keyed on data-open); a tiny progressive script toggles it + locks scroll +
// closes on backdrop / link / Escape.
import { ArrowRight, Play, Menu, X, BookText, Package, Plug, Link2, Compass, Handshake, Github, Newspaper, Route } from 'lucide-astro'

interface Props {
  path?: string
}
const { path = '' } = Astro.props
const onDemo = path === '/demo' || path === '/demo/'

// Active-state helper for the secondary on-site links.
const norm = (p: string) => (p.endsWith('/') ? p.slice(0, -1) : p) || '/'
const isActive = (p: string) => norm(path) === norm(p)
const linkCls = (p: string) =>
  isActive(p)
    ? 'hidden items-center gap-1.5 rounded-lg px-3 py-1.5 text-sm font-medium text-neutral-100 lg:inline-flex'
    : 'hidden items-center gap-1.5 rounded-lg px-3 py-1.5 text-sm text-muted transition hover:bg-white/5 hover:text-neutral-100 lg:inline-flex'

// Every secondary link, in one list — rendered in the desktop bar and/or the
// mobile overlay, so the two can never drift. `mobileOnly` keeps the desktop bar
// uncrowded (Partners lives in the overlay + footer, not the inline bar).
// Facilitators is a full desktop link, not `mobileOnly`: it is the page people arrive at from
// search, and it must be reachable from the header wherever the header shows links at all.
//
// 🔴 IT CANNOT BE `mobileOnly` OR xl-ONLY. The hamburger is `lg:hidden`, so between 1024px and
// 1279px there is no overlay AND no burger — an overlay-only link is simply unreachable from
// the header in that whole range. Measured at 1024px: the bar with Facilitators is 877px
// against a 916px budget, so it fits with room to spare; adding the burger back as an overflow
// affordance does NOT fit (921px), which is why the link goes in the bar rather than the burger
// staying on. (Discovery and Partners are still overlay-only and so share that 1024–1279 gap —
// they remain reachable from the footer on every page.)
const navLinks = [
  { href: 'https://docs.piprail.com', label: 'Docs', icon: BookText },
  { href: '/sdk/', label: 'SDK', icon: Package },
  { href: '/mcp/', label: 'MCP', icon: Plug },
  { href: '/chains/', label: 'Chains', icon: Link2 },
  { href: '/facilitators/', label: 'Facilitators', icon: Route },
  { href: '/blog/', label: 'Blog', icon: Newspaper },
  { href: '/discovery/', label: 'Discovery', mobileOnly: true, icon: Compass },
  { href: '/partners/', label: 'Partners', mobileOnly: true, icon: Handshake },
  { href: 'https://github.com/piprail/piprail', label: 'GitHub', icon: Github },
]
const desktopLinks = navLinks.filter((l) => !l.mobileOnly)
// Mobile-overlay link styling (active vs idle).
const mobileLinkCls = (href: string) =>
  isActive(href)
    ? 'flex items-center gap-3 rounded-lg px-3 py-2.5 text-[15px] font-medium text-neutral-100 bg-white/5'
    : 'flex items-center gap-3 rounded-lg px-3 py-2.5 text-[15px] text-neutral-300 transition hover:bg-white/5 hover:text-neutral-100'
---

<header class="sticky top-0 z-50 border-b border-white/5 bg-bg/70 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:px-6">
    <a href="/" class="flex items-center gap-2.5 font-semibold tracking-tight" aria-label="PipRail — home">
      <img src="/logo.png" alt="" width="28" height="28" class="h-7 w-7 rounded-lg ring-1 ring-white/10" />
      <span>PipRail</span>
    </a>

    <nav class="flex items-center gap-1.5 sm:gap-2" aria-label="Primary">
      <!-- Desktop inline nav — md and up -->
      <a
        href="/demo/"
        aria-current={onDemo ? 'page' : undefined}
        class:list={[
          'hidden shrink-0 items-center gap-1.5 whitespace-nowrap rounded-full border px-3 py-1.5 text-sm font-medium transition lg:inline-flex',
          onDemo
            ? 'border-accent/40 bg-accent/15 text-accent'
            : 'border-accent/20 bg-accent/8 text-accent hover:border-accent/40 hover:bg-accent/15',
        ]}
      >
        <Play size={13} aria-hidden="true" fill="currentColor" /> Demo
      </a>
      {desktopLinks.map((l) => {
        const Icon = l.icon
        return (
          <a href={l.href} class={linkCls(l.href)} aria-current={isActive(l.href) ? 'page' : undefined}>
            <Icon size={14} aria-hidden="true" class="opacity-80" /> {l.label}
          </a>
        )
      })}

      <!-- Hamburger — tablet & mobile only. Opens the slide-in overlay below. -->
      <button
        id="nav-open"
        type="button"
        aria-label="Open menu"
        aria-controls="mobile-nav"
        aria-expanded="false"
        class="flex h-9 w-9 items-center justify-center rounded-lg border border-white/10 text-neutral-300 transition hover:text-neutral-100 lg:hidden"
      >
        <Menu size={18} aria-hidden="true" />
      </button>

      <!-- primary CTA — always visible -->
      <a
        href="https://www.npmjs.com/package/@piprail/sdk"
        class="ml-1 inline-flex shrink-0 items-center gap-1.5 whitespace-nowrap rounded-lg bg-accent px-3.5 py-2 text-sm font-semibold text-neutral-950 transition hover:brightness-110 sm:px-4"
      >
        Get started <ArrowRight size={15} aria-hidden="true" class="hidden sm:inline" />
      </a>
    </nav>
  </div>
</header>

<!-- Tablet/mobile slide-in overlay (< md). Backdrop fades, panel slides from the
     right; CSS keys off data-open, the script below toggles it. -->
<div
  id="mobile-nav"
  data-open="false"
  aria-hidden="true"
  inert
  class="group/nav fixed inset-0 z-60 opacity-0 pointer-events-none transition-opacity duration-200 data-[open=true]:opacity-100 data-[open=true]:pointer-events-auto lg:hidden"
>
  <!-- backdrop (click to close) -->
  <div data-close class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>

  <!-- panel -->
  <div class="absolute right-0 top-0 flex h-full w-4/5 max-w-xs translate-x-full flex-col border-l border-white/10 bg-neutral-950 shadow-2xl shadow-black/50 transition-transform duration-300 ease-out group-data-[open=true]/nav:translate-x-0">
    <div class="flex items-center justify-between border-b border-white/10 px-5 py-4">
      <span class="flex items-center gap-2.5 font-semibold tracking-tight">
        <img src="/logo.png" alt="" width="24" height="24" class="h-6 w-6 rounded-md ring-1 ring-white/10" /> PipRail
      </span>
      <button data-close type="button" aria-label="Close menu" class="flex h-9 w-9 items-center justify-center rounded-lg border border-white/10 text-neutral-300 transition hover:text-neutral-100">
        <X size={18} aria-hidden="true" />
      </button>
    </div>

    <nav class="flex flex-1 flex-col gap-1 overflow-y-auto p-4" aria-label="Mobile">
      <a
        href="/demo/"
        aria-current={onDemo ? 'page' : undefined}
        class:list={[
          'flex items-center gap-2 rounded-lg border px-3 py-2.5 text-[15px] font-medium transition',
          onDemo ? 'border-accent/40 bg-accent/15 text-accent' : 'border-accent/20 bg-accent/8 text-accent hover:bg-accent/15',
        ]}
      >
        <Play size={14} fill="currentColor" aria-hidden="true" /> Demo
      </a>
      {navLinks.map((l) => {
        const Icon = l.icon
        return (
          <a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined} class={mobileLinkCls(l.href)}>
            <Icon size={17} aria-hidden="true" class="shrink-0 text-neutral-400" /> {l.label}
          </a>
        )
      })}
    </nav>

    <div class="border-t border-white/10 p-4">
      <a
        href="https://www.npmjs.com/package/@piprail/sdk"
        class="flex items-center justify-center gap-1.5 rounded-lg bg-accent px-4 py-3 text-sm font-semibold text-neutral-950 transition hover:brightness-110"
      >
        Get started <ArrowRight size={15} aria-hidden="true" />
      </a>
    </div>
  </div>
</div>

<!-- Progressive enhancement: toggle the overlay (slide + fade via CSS), lock
     scroll, manage focus, and close on backdrop / link / Escape. Also survives a
     resize past the lg breakpoint and a bfcache restore — so the scroll lock can
     never strand a page. -->
<script is:inline>
  ;(() => {
    const overlay = document.getElementById('mobile-nav')
    const openBtn = document.getElementById('nav-open')
    if (!overlay || !openBtn) return

    const set = (open) => {
      overlay.dataset.open = String(open)
      overlay.inert = !open // closed panel leaves the tab order + AX tree (implies aria-hidden)
      overlay.setAttribute('aria-hidden', String(!open))
      openBtn.setAttribute('aria-expanded', String(open))
      document.documentElement.style.overflow = open ? 'hidden' : ''
    }
    const open = () => {
      set(true)
      overlay.querySelector('button[data-close]')?.focus() // move focus into the panel
    }
    const close = () => {
      const wasOpen = overlay.dataset.open === 'true'
      set(false)
      if (wasOpen) openBtn.focus() // restore focus to the trigger
    }

    openBtn.addEventListener('click', open)
    overlay.addEventListener('click', (e) => {
      if (e.target.closest('[data-close]') || e.target.closest('a')) close()
    })
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && overlay.dataset.open === 'true') close()
    })
    // Crossing to desktop (lg) hides the overlay via CSS — clear the lock + state too.
    window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
      if (e.matches) set(false)
    })
    // A bfcache restore can return with a stale lock — reset on show.
    window.addEventListener('pageshow', (e) => {
      if (e.persisted) set(false)
    })
    set(false) // assert the closed state at init (authoritative; clears any stale lock)
  })()
</script>
