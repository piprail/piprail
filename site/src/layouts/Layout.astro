---
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
  /** Per-page social card under /public (e.g. '/og-sdk.png'); defaults to the site card. */
  ogImage?: string
}

const {
  title = 'PipRail — x402 crypto payment SDK for every chain (EVM, Solana, TON, Tron, NEAR, Sui, Aptos, Algorand, Stellar, XRPL)',
  description =
    'Accept and make x402 crypto payments on any EVM chain, Solana, TON, Tron, NEAR, Sui, Aptos, Algorand, Stellar, and the XRP Ledger — in one line. No middleman, no account, no fee: USDC/USDT settles straight to your wallet, verified locally against your own RPC. Agent-safe spend budgets, one-line multi-chain, pre-pay gas estimates, plus an MCP server so Claude, Cursor, and any agent pay autonomously. The drop-in payment SDK for AI agents.',
  ogImage: ogImageProp,
} = Astro.props

const site = Astro.site?.href.replace(/\/$/, '') ?? 'https://piprail.com'
const canonical = new URL(Astro.url.pathname, site).href
const ogImage = `${site}${ogImageProp ?? '/og.png'}`

// What PipRail can do — a machine-readable capability list for search engines and
// AI agents scraping the page. Mirrors the SDK's actual feature set.
const featureList = [
  'One-line x402 (HTTP 402 Payment Required) payments — gate a server route, or auto-pay as a client',
  'Widest native, self-custodial chain coverage of any x402 SDK — the only package that reaches TON, Tron, NEAR, Sui, Aptos, Algorand, and the XRP Ledger together, with the payer broadcasting their own transfer (no facilitator settling in the middle)',
  '28 chains built in: 19 EVM mainnets, Solana, TON, Tron, NEAR, Sui, Aptos, Algorand, Stellar, and the XRP Ledger — one parameter picks the chain',
  'Pay in USDC, USDT, EURC, or the chain native coin; any other token by address',
  'No hosted backend, no database, no account, no fee, no hosted facilitator — self-custody, verified locally against your own RPC',
  'Agent spend controls: per-call and lifetime budgets with chain/token/host allowlists, refused before any on-chain send',
  'Quote a price without paying, approve each payment, and read back a per-token spend ledger',
  'Multi-chain accepts: one challenge offers several chains and the agent pays with what it holds',
  'x402 discovery: emit a machine-readable manifest, register your endpoint on the open indexes (402 Index, CDP Bazaar), and find payable APIs — on every chain, with no hosted registry',
  'Framework-agnostic agent toolkit for MCP, the Vercel AI SDK, and LLM function-calling',
  'TypeScript, runs headless or in the browser, MIT licensed',
]

// SoftwareApplication structured data — helps search engines + AI agents understand the product.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  '@id': 'https://piprail.com/#sdk',
  name: 'PipRail',
  alternateName: '@piprail/sdk',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Node.js, Browser',
  description,
  url: site,
  downloadUrl: 'https://www.npmjs.com/package/@piprail/sdk',
  codeRepository: 'https://github.com/piprail/piprail',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  programmingLanguage: 'TypeScript',
  license: 'https://opensource.org/licenses/MIT',
  author: { '@type': 'Person', name: 'John Weeks' },
  featureList,
  keywords:
    'x402, crypto payments, agent payments, agentic commerce, machine payments, x402 discovery, service discovery, 402 Index, EVM, Solana, TON, Tron, NEAR, Sui, Aptos, Algorand, Stellar, XRPL, XRP, USDC, USDT, EURC, RLUSD, ALGO, stablecoin, 402 Payment Required, AI agents, MCP, multi-chain, spend budget, web3 SDK',
}

// Entity + repository structured data — complements the SoftwareApplication above
// (helps search engines and AI answer engines build a knowledge graph for PipRail).
const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://piprail.com/#organization',
  name: 'PipRail',
  url: 'https://piprail.com',
  logo: 'https://piprail.com/logo.png',
  image: 'https://piprail.com/og.png',
  description:
    'Open-source, backendless, no-fee x402 crypto-payment SDK for AI agents across 28 blockchains in 10 families.',
  founder: { '@type': 'Person', name: 'John Weeks' },
  sameAs: [
    'https://github.com/piprail/piprail',
    'https://www.npmjs.com/package/@piprail/sdk',
    'https://x.com/johnweeksdev',
  ],
}

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': 'https://piprail.com/#website',
  name: 'PipRail',
  url: 'https://piprail.com',
  description:
    'The payment layer for the agent economy — x402 crypto payments on 28 chains, no backend, no fee.',
  publisher: { '@id': 'https://piprail.com/#organization' },
  inLanguage: 'en',
}

const sourceLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  '@id': 'https://piprail.com/#sourcecode',
  name: '@piprail/sdk',
  description:
    'TypeScript SDK for x402 (HTTP 402 Payment Required) agent payments across 28 chains in 10 families — EVM, Solana, TON, Tron, NEAR, Sui, Aptos, Algorand, Stellar, and the XRP Ledger. Backendless and self-custodial: payments settle straight to your wallet, verified locally against your own RPC.',
  url: 'https://github.com/piprail/piprail',
  codeRepository: 'https://github.com/piprail/piprail',
  programmingLanguage: 'TypeScript',
  runtimePlatform: 'Node.js, Browser',
  license: 'https://opensource.org/licenses/MIT',
  author: { '@type': 'Person', name: 'John Weeks' },
  maintainer: { '@id': 'https://piprail.com/#organization' },
  targetProduct: { '@id': 'https://piprail.com/#organization' },
}

// @piprail/mcp — its own SoftwareApplication entity so search + AI answer engines
// index "PipRail MCP server" as a distinct, installable product alongside the SDK.
const mcpLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  '@id': 'https://piprail.com/#mcp',
  name: '@piprail/mcp',
  alternateName: 'PipRail MCP server',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Node.js',
  description:
    'A Model Context Protocol (MCP) server that hands any AI agent — Claude Desktop, Cursor, Claude Code, Windsurf, VS Code, Cline — a budget-bound wallet to pay, discover, and register x402 payment-gated URLs autonomously across 28 chains. Five tools: find, quote, plan, pay, and register. Runs locally with your own wallet and spend caps; no backend, no custody. Listed in the official MCP registry as io.github.piprail/mcp. Install with: npx -y @piprail/mcp.',
  url: 'https://piprail.com/mcp',
  downloadUrl: 'https://www.npmjs.com/package/@piprail/mcp',
  codeRepository: 'https://github.com/piprail/piprail',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  programmingLanguage: 'TypeScript',
  license: 'https://opensource.org/licenses/MIT',
  author: { '@type': 'Person', name: 'John Weeks' },
  isPartOf: { '@id': 'https://piprail.com/#organization' },
  softwareHelp: { '@type': 'CreativeWork', url: 'https://github.com/piprail/piprail/blob/main/mcp/README.md' },
  keywords:
    'mcp, model context protocol, mcp server, mcp registry, x402, x402 discovery, agent payments, ai agents, claude desktop, cursor, crypto payments, usdc, autonomous payments, agentic commerce, wallet',
}

// Search-console verification (env-gated, build-time). Set as Netlify env vars to verify
// via the HTML-tag method with zero code change; they render nothing when unset. The
// recommended GSC "Domain" property uses a DNS TXT record instead and needs neither.
// See .claude/research/seo-monitoring-setup.md.
const gscVerification = import.meta.env.PUBLIC_GSC_VERIFICATION ?? 'LPx85yBDaIQPQ6DJWuub0OcnlZO8ra9nrQCxr5vzH-g'
const bingVerification = import.meta.env.PUBLIC_BING_VERIFICATION
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    {gscVerification && <meta name="google-site-verification" content={gscVerification} />}
    {bingVerification && <meta name="msvalidate.01" content={bingVerification} />}

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={site} />
    <meta name="theme-color" content="#0a0b0c" />
    <meta
      name="keywords"
      content="x402, crypto payment SDK, agent payments, agentic commerce, EVM, Solana, TON, Tron, NEAR, Sui, Aptos, Algorand, Stellar, XRPL, XRP, USDC, USDT, EURC, RLUSD, ALGO, stablecoin, 402 Payment Required, AI agents, MCP, MCP server, Model Context Protocol, Claude Desktop, Cursor, autonomous payments, multi-chain, spend budget, web3, machine payments"
    />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="PipRail" />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="PipRail — the open-source x402 crypto-payment SDK for AI agents across 28 chains" />
    <meta name="twitter:site" content="@johnweeksdev" />
    <meta name="twitter:creator" content="@johnweeksdev" />

    <!-- Indexing + image previews (explicit; AI/search results render larger) -->
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="PipRail — the open-source x402 crypto-payment SDK for AI agents across 28 chains" />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(orgLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(sourceLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(mcpLd)} />
  </head>
  <body class="min-h-screen antialiased">
    <slot />

    <!-- Open every EXTERNAL link in a new tab by default, with a safe rel.
         One place, so it covers every page + any link added later. Internal
         links and in-page anchors are left untouched; degrades gracefully
         (links still work without JS, just same-tab). -->
    <script is:inline>
      for (const a of document.querySelectorAll('a[href]')) {
        try {
          const u = new URL(a.href, location.href)
          if (u.origin !== location.origin && (u.protocol === 'http:' || u.protocol === 'https:')) {
            a.target = '_blank'
            a.rel = 'noopener noreferrer'
          }
        } catch {}
      }
    </script>
  </body>
</html>
