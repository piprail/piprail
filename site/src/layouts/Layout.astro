---
import '../styles/global.css'
import Analytics from '../components/Analytics.astro'
import SocialRail from '../components/SocialRail.astro'

interface Props {
  title?: string
  description?: string
  /** Per-page social card under /public (e.g. '/og-sdk.png'); defaults to the site card. */
  ogImage?: string
  /** Open Graph type — 'website' (default) for product pages, 'article' for blog posts. */
  ogType?: string
  /** Article metadata — set on blog posts; renders the article:* OG tags for richer
   *  social + answer-engine cards. Dates are ISO-8601 strings. */
  article?: {
    publishedTime?: string
    modifiedTime?: string
    author?: string
    section?: string
    tags?: string[]
  }
}

const {
  title = 'PipRail — x402 crypto payment SDK for every chain (EVM, Solana, TON, Tron, NEAR, Sui, Aptos, Algorand, Stellar, XRPL)',
  description =
    'Accept and make x402 crypto payments on any EVM chain, Solana, TON, Tron, NEAR, Sui, Aptos, Algorand, Stellar, and the XRP Ledger — in one line. No middleman, no account, no fee: USDC/USDT settles straight to your wallet, verified locally against your own RPC. Agent-safe spend budgets, one-line multi-chain, pre-pay gas estimates, plus an MCP server so Claude, Cursor, and any agent pay autonomously. The drop-in payment SDK for AI agents.',
  ogImage: ogImageProp,
  ogType = 'website',
  article,
} = Astro.props

const site = Astro.site?.href.replace(/\/$/, '') ?? 'https://piprail.com'
const canonical = new URL(Astro.url.pathname, site).href
const ogImage = `${site}${ogImageProp ?? '/og.png'}`

// What PipRail can do — a machine-readable capability list for search engines and
// AI agents scraping the page. Mirrors the SDK's actual feature set.
const featureList = [
  'One-line x402 (HTTP 402 Payment Required) payments — gate a server route, or auto-pay as a client',
  'Widest native, self-custodial chain coverage of any x402 SDK — the only package that reaches TON, Tron, NEAR, Sui, Aptos, Algorand, and the XRP Ledger together, with the payer broadcasting their own transfer (no facilitator settling in the middle)',
  '29 chains built in: 20 EVM mainnets, Solana, TON, Tron, NEAR, Sui, Aptos, Algorand, Stellar, and the XRP Ledger — one parameter picks the chain',
  'Pay in USDC, USDT, EURC, or the chain native coin; any other token by address',
  'No hosted backend, no database, no account, no fee, no hosted facilitator — self-custody, verified locally against your own RPC',
  'Agent spend controls: per-call and lifetime budgets with chain/token/host allowlists, refused before any on-chain send',
  'Quote a price without paying, approve each payment, and read back a per-token spend ledger',
  'Multi-chain accepts: one challenge offers several chains and the agent pays with what it holds',
  'x402 discovery: emit a machine-readable manifest, register your endpoint on the open indexes (402 Index, CDP Bazaar), and find payable APIs — on every chain, with no hosted registry',
  'Framework-agnostic agent toolkit for MCP, the Vercel AI SDK, and LLM function-calling',
  'TypeScript, runs headless or in the browser, MIT licensed',
]

// SoftwareApplication structured data — helps search engines + AI agents understand the product.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  '@id': 'https://piprail.com/#sdk',
  name: 'PipRail',
  alternateName: '@piprail/sdk',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Node.js, Browser',
  description,
  url: site,
  downloadUrl: 'https://www.npmjs.com/package/@piprail/sdk',
  codeRepository: 'https://github.com/piprail/piprail',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  programmingLanguage: 'TypeScript',
  license: 'https://opensource.org/licenses/MIT',
  author: { '@type': 'Person', name: 'John Weeks' },
  featureList,
  keywords:
    'x402, crypto payments, agent payments, agentic commerce, machine payments, x402 discovery, service discovery, 402 Index, EVM, Solana, TON, Tron, NEAR, Sui, Aptos, Algorand, Stellar, XRPL, XRP, USDC, USDT, EURC, RLUSD, ALGO, stablecoin, 402 Payment Required, AI agents, MCP, multi-chain, spend budget, web3 SDK',
}

// Entity + repository structured data — complements the SoftwareApplication above
// (helps search engines and AI answer engines build a knowledge graph for PipRail).
const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://piprail.com/#organization',
  name: 'PipRail',
  url: 'https://piprail.com',
  logo: 'https://piprail.com/logo.png',
  image: 'https://piprail.com/og.png',
  description:
    'Open-source, backendless, no-fee x402 crypto-payment SDK for AI agents across 29 blockchains in 10 families.',
  founder: { '@type': 'Person', name: 'John Weeks' },
  sameAs: [
    'https://github.com/piprail/piprail',
    'https://www.npmjs.com/package/@piprail/sdk',
    'https://x.com/piprailhq',
    // 🔴 The VANITY form, never the numeric one LinkedIn hands you at creation:
    // logged out that serves a sign-in wall at HTTP 200, and every crawler reading
    // this node is logged out. Guarded by the `sameas-mirrors` sync rule.
    'https://www.linkedin.com/company/piprail',
  ],
}

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': 'https://piprail.com/#website',
  name: 'PipRail',
  url: 'https://piprail.com',
  description:
    'The payment layer for the agent economy — x402 crypto payments on 29 chains, no backend, no fee.',
  publisher: { '@id': 'https://piprail.com/#organization' },
  inLanguage: 'en',
}

const sourceLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  '@id': 'https://piprail.com/#sourcecode',
  name: '@piprail/sdk',
  description:
    'TypeScript SDK for x402 (HTTP 402 Payment Required) agent payments across 29 chains in 10 families — EVM, Solana, TON, Tron, NEAR, Sui, Aptos, Algorand, Stellar, and the XRP Ledger. Backendless and self-custodial: payments settle straight to your wallet, verified locally against your own RPC.',
  url: 'https://github.com/piprail/piprail',
  codeRepository: 'https://github.com/piprail/piprail',
  programmingLanguage: 'TypeScript',
  runtimePlatform: 'Node.js, Browser',
  license: 'https://opensource.org/licenses/MIT',
  author: { '@type': 'Person', name: 'John Weeks' },
  maintainer: { '@id': 'https://piprail.com/#organization' },
  // targetProduct expects a SoftwareApplication, NOT an Organization — pointing it at
  // #organization is a schema.org type violation that validators flag on every page.
  targetProduct: { '@id': 'https://piprail.com/#sdk' },
}

// @piprail/mcp — its own SoftwareApplication entity so search + AI answer engines
// index "PipRail MCP server" as a distinct, installable product alongside the SDK.
const mcpLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  '@id': 'https://piprail.com/#mcp',
  name: '@piprail/mcp',
  alternateName: 'PipRail MCP server',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Node.js',
  description:
    'A Model Context Protocol (MCP) server that hands any AI agent — Claude Desktop, Cursor, Claude Code, Windsurf, VS Code, Cline — a budget-bound wallet to pay, discover, and register x402 payment-gated URLs autonomously across 29 chains. Eight tools: discover, quote, plan, pay, register, read remaining budget, a self-describing agent guide, and on-chain receipt verification. Runs locally with your own wallet and spend caps; no backend, no custody. Listed in the official MCP registry as io.github.piprail/mcp. Install with: npx -y @piprail/mcp.',
  url: 'https://piprail.com/mcp',
  downloadUrl: 'https://www.npmjs.com/package/@piprail/mcp',
  codeRepository: 'https://github.com/piprail/piprail',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  programmingLanguage: 'TypeScript',
  license: 'https://opensource.org/licenses/MIT',
  author: { '@type': 'Person', name: 'John Weeks' },
  isPartOf: { '@id': 'https://piprail.com/#organization' },
  softwareHelp: { '@type': 'CreativeWork', url: 'https://github.com/piprail/piprail/blob/main/mcp/README.md' },
  keywords:
    'mcp, model context protocol, mcp server, mcp registry, x402, x402 discovery, agent payments, ai agents, claude desktop, cursor, crypto payments, usdc, autonomous payments, agentic commerce, wallet',
}

// Search-console verification (env-gated, build-time). Set as Netlify env vars to verify
// via the HTML-tag method with zero code change; they render nothing when unset. The
// recommended GSC "Domain" property uses a DNS TXT record instead and needs neither.
// See .claude/research/seo-monitoring-setup.md.
const gscVerification = import.meta.env.PUBLIC_GSC_VERIFICATION ?? 'LPx85yBDaIQPQ6DJWuub0OcnlZO8ra9nrQCxr5vzH-g'
// Account-wide Bing Webmaster code (one code covers every site on the account).
// ChatGPT search + Copilot run on the Bing index, so this is an AEO lever, not just SEO.
const bingVerification =
  import.meta.env.PUBLIC_BING_VERIFICATION ?? '4C2A94BD8695D97BC9033E2A6E5002D5'

// GA4 — the property already existed (551957171 "PipRail", stream piprail.com) but the tag was
// NEVER installed, so it collected nothing while Search Console made it look measured. GSC tells
// you what SEARCH did; GA4 tells you what the visitor did after arriving, and where they came
// from. Defaulted to the real measurement id, exactly like the verification tags above, so it
// works without any Netlify env var; override with PUBLIC_GA4_ID (set it empty to disable).
const ga4Id = import.meta.env.PUBLIC_GA4_ID ?? 'G-17GKJNMGDX'

// Cookieless web analytics — an ALTERNATIVE to GA4, not a requirement. Left wired because the
// config has always advertised it, but with GA4 live you do not need either of these.
// 🔴 `site/.env.example` has documented these two since launch as "both inert until set",
// but NOTHING rendered them: setting the Netlify var did literally nothing, and the site
// shipped with zero visitor analytics while appearing to be configured for it. Search
// Console tells you what SEARCH did; neither tells you what visitors did once they arrived.
// Both stay genuinely inert when unset, so this changes nothing until a token exists.
const cfBeaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN
const goatcounterUrl = import.meta.env.PUBLIC_GOATCOUNTER_URL
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    {gscVerification && <meta name="google-site-verification" content={gscVerification} />}
    {ga4Id && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`} />
        <script
          is:inline
          set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','${ga4Id}');`}
        />
      </>
    )}
    {cfBeaconToken && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${cfBeaconToken}"}`}
      />
    )}
    {goatcounterUrl && (
      <script defer data-goatcounter={goatcounterUrl} src="//gc.zgo.at/count.js" />
    )}
    {bingVerification && <meta name="msvalidate.01" content={bingVerification} />}

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <meta name="theme-color" content="#0a0b0c" />
    <meta
      name="keywords"
      content="x402, crypto payment SDK, agent payments, agentic commerce, EVM, Solana, TON, Tron, NEAR, Sui, Aptos, Algorand, Stellar, XRPL, XRP, USDC, USDT, EURC, RLUSD, ALGO, stablecoin, 402 Payment Required, AI agents, MCP, MCP server, Model Context Protocol, Claude Desktop, Cursor, autonomous payments, multi-chain, spend budget, web3, machine payments"
    />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="PipRail" />
    <meta property="og:image" content={ogImage} />

    <!-- Article OG (blog posts only) — richer link previews + answer-engine context -->
    {article?.publishedTime && <meta property="article:published_time" content={article.publishedTime} />}
    {article?.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime} />}
    {article?.author && <meta property="article:author" content={article.author} />}
    {article?.section && <meta property="article:section" content={article.section} />}
    {article?.tags?.map((t) => <meta property="article:tag" content={t} />)}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="PipRail — the open-source x402 crypto-payment SDK for AI agents across 29 chains" />
    <meta name="twitter:site" content="@piprailhq" />
    <meta name="twitter:creator" content="@johnweeksdev" />

    <!-- Indexing + image previews (explicit; AI/search results render larger) -->
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="PipRail — the open-source x402 crypto-payment SDK for AI agents across 29 chains" />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(orgLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(sourceLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(mcpLd)} />

    <!-- Per-page head extras (e.g. a blog post's BlogPosting JSON-LD). -->
    <slot name="head" />

    <Analytics />
  </head>
  <body class="relative min-h-screen antialiased">
    <!-- Hero ambience: faint glow orbs + drifting particles, far in the background. Decorative. -->
    <div class="hero-orb hero-orb-1" aria-hidden="true"></div>
    <div class="hero-orb hero-orb-2" aria-hidden="true"></div>
    <div class="hero-dots" aria-hidden="true">
      {[
        {x:6,y:40,s:3,o:.32,a:'a',d:17,dl:0}, {x:13,y:130,s:2,o:.20,a:'b',d:21,dl:3}, {x:21,y:70,s:2,o:.18,a:'c',d:19,dl:6},
        {x:29,y:180,s:4,o:.36,a:'a',d:23,dl:1}, {x:37,y:30,s:2,o:.22,a:'b',d:15,dl:4}, {x:44,y:130,s:3,o:.28,a:'c',d:25,dl:7},
        {x:51,y:80,s:2,o:.16,a:'a',d:18,dl:2}, {x:58,y:210,s:3,o:.34,a:'b',d:22,dl:5}, {x:64,y:50,s:2,o:.20,a:'c',d:16,dl:8},
        {x:70,y:150,s:4,o:.38,a:'a',d:24,dl:0}, {x:78,y:90,s:2,o:.18,a:'b',d:20,dl:3}, {x:84,y:40,s:3,o:.30,a:'c',d:17,dl:6},
        {x:90,y:160,s:2,o:.22,a:'a',d:26,dl:2}, {x:95,y:100,s:3,o:.26,a:'b',d:19,dl:5}, {x:10,y:250,s:2,o:.16,a:'c',d:23,dl:7},
        {x:26,y:310,s:3,o:.30,a:'a',d:21,dl:1}, {x:42,y:270,s:2,o:.18,a:'b',d:18,dl:4}, {x:56,y:350,s:4,o:.34,a:'c',d:25,dl:6},
        {x:72,y:300,s:2,o:.20,a:'a',d:17,dl:8}, {x:88,y:330,s:3,o:.28,a:'b',d:22,dl:0}, {x:18,y:430,s:2,o:.16,a:'c',d:24,dl:3},
        {x:48,y:470,s:3,o:.26,a:'a',d:20,dl:5}, {x:66,y:410,s:2,o:.18,a:'b',d:19,dl:7}, {x:82,y:500,s:3,o:.28,a:'c',d:23,dl:2},
        {x:34,y:560,s:2,o:.15,a:'a',d:21,dl:4}, {x:60,y:580,s:2,o:.16,a:'b',d:18,dl:6},
      ].map((p) => (
        <i style={`left:${p.x}%;top:${p.y}px;width:${p.s}px;height:${p.s}px;--o:${p.o};animation:float-${p.a} ${p.d}s ease-in-out ${p.dl}s infinite`}></i>
      ))}
    </div>
    <slot />

    <!-- Global "like & share" quick-links rail (GitHub · X · ClawHub · Share) —
         a slim left dock on wide screens, a bottom pill on phones/tablets. -->
    <SocialRail />

    <!-- Open every EXTERNAL link in a new tab by default, with a safe rel.
         One place, so it covers every page + any link added later. Internal
         links and in-page anchors are left untouched; degrades gracefully
         (links still work without JS, just same-tab). -->
    <script is:inline>
      for (const a of document.querySelectorAll('a[href]')) {
        try {
          const u = new URL(a.href, location.href)
          if (u.origin !== location.origin && (u.protocol === 'http:' || u.protocol === 'https:')) {
            a.target = '_blank'
            a.rel = 'noopener noreferrer'
          }
        } catch {}
      }
    </script>
  </body>
</html>
