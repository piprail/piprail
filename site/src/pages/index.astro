---
import Layout from '../layouts/Layout.astro'
import Navigation from '../components/Navigation.astro'
import Footer from '../components/Footer.astro'
import CodeWindow from '../components/CodeWindow.astro'
import SectionHeading from '../components/SectionHeading.astro'
import { chains } from '../data/chains'
import { acceptCode, payCode, mcpConfigCode } from '../data/snippets'
import {
  Zap, Coins, ShieldCheck, PackageCheck, Boxes, Code2,
  ArrowRight, ChevronDown, Play, Bot, Plug, Wallet, Sparkles, Handshake,
  Search, Megaphone,
} from 'lucide-astro'

// Counts are DERIVED from the chain data — never hardcoded, so nothing can drift.
const total = chains.length
const familyCount = [...new Set(chains.map((c) => c.family))].length
const evmCount = chains.filter((c) => c.family === 'EVM').length

// Hero chain marquee — BNB leads, then prominence order; the 2nd row runs the
// reverse so the two lanes never read as vertical twins. Rendered twice per lane
// for a seamless loop (see .marquee in global.css).
const marqueeA = [...chains].sort((a, b) => (a.slug === 'bnb' ? -1 : b.slug === 'bnb' ? 1 : 0))
const marqueeB = [...marqueeA].reverse()

// Concise, front-loaded, count-derived meta — the homepage is the brand anchor.
const title = 'PipRail — x402 crypto payments for AI agents, every chain'
const description = `Accept x402 crypto payments on ${total} chains — or hand your AI agent a wallet to pay on its own. One line, USDC/USDT/native straight to your wallet. No backend, no fee, MIT.`

// The neutrality pillar: open standard, nobody in the middle, both rails.
const interop = [
  { icon: ShieldCheck, t: 'Nobody in the middle', d: 'No facilitator, no relayer, no custody. The payer broadcasts their own transfer; you verify it against your own RPC. Funds land straight in your wallet — no one can take a cut, throttle you, or shut you off.' },
  { icon: Handshake, t: 'The open standard', d: 'x402 was donated to the Linux Foundation — the neutral rail the agent economy is converging on. PipRail’s envelope is v2-conformant, so any x402 client — Coinbase’s, the reference client, anyone’s — can pay your gate.' },
  { icon: Boxes, t: 'One gate, both rails', d: 'Advertise the backendless onchain-proof rail and the ratified exact (EIP-3009) rail at once — standard clients pick one, PipRail clients the other. Proven end-to-end against the official x402 reference client on Base mainnet.' },
]

const steps = [
  { icon: Zap, n: '01', t: 'Agent calls your route', d: 'It gets back a 402 quote — price, token, payTo, chain.' },
  { icon: Coins, n: '02', t: 'Agent pays on-chain', d: 'One transfer, straight to your wallet. PipRail never touches the funds.' },
  { icon: ShieldCheck, n: '03', t: 'You verify locally', d: 'Your server checks the tx against your own RPC: succeeded, recent, right amount + recipient.' },
  { icon: PackageCheck, n: '04', t: 'You return the data', d: '200 OK — and the same proof can never be spent twice.' },
]

// Representative logo per family — EVM stands for all its mainnets behind one driver.
const familyLogos = [
  { slug: 'ethereum', label: `EVM ×${evmCount}` },
  { slug: 'solana', label: 'Solana' }, { slug: 'ton', label: 'TON' }, { slug: 'tron', label: 'Tron' },
  { slug: 'near', label: 'NEAR' }, { slug: 'sui', label: 'Sui' }, { slug: 'aptos', label: 'Aptos' },
  { slug: 'algorand', label: 'Algorand' }, { slug: 'stellar', label: 'Stellar' }, { slug: 'xrpl', label: 'XRPL' },
]

// "One protocol. Every chain." panel — surface the flagship EVM family with BNB
// FIRST (and highlighted), then the 9 non-EVM families (one native driver each).
const evmOrdered = [...chains.filter((c) => c.family === 'EVM')].sort((a, b) => (a.slug === 'bnb' ? -1 : b.slug === 'bnb' ? 1 : 0))
const evmFeatured = evmOrdered.slice(0, 8)
const evmMore = evmOrdered.length - evmFeatured.length
const nonEvmFamilies = familyLogos.slice(1)

// A diverse handful of logos for the "fragmented world" node in the story diagram.
const fragmentLogos = ['ethereum', 'solana', 'bnb', 'xrpl', 'tron', 'stellar']

const mcpTools = [
  { name: 'piprail_discover', desc: 'find payable APIs on the open indexes — the phone book' },
  { name: 'piprail_quote_payment', desc: 'price a gated URL — without paying' },
  { name: 'piprail_plan_payment', desc: 'check it can afford it: balance, gas, recipient-readiness' },
  { name: 'piprail_pay_request', desc: 'fetch it, paying the 402 automatically' },
  { name: 'piprail_register', desc: 'list an endpoint you run so other agents find it' },
  { name: 'piprail_budget', desc: 'read the remaining spend budget + time leash' },
  { name: 'piprail_guide', desc: 'read the agent contract — how to quote, plan, pay' },
]

// Top questions only — the rest live on /sdk, /mcp, /chains, /discovery (each with its own schema).
const faqs = [
  {
    q: `What is PipRail?`,
    a: `PipRail is an open-source (MIT) TypeScript SDK for x402 crypto payments. It lets any HTTP endpoint charge for itself, and lets AI agents pay for APIs on their own — across ${total} chains, with no backend, no database, no account, and no fee. Payments settle straight to your own wallet, verified locally against your own RPC. It ships as two packages: @piprail/sdk (the library) and @piprail/mcp (an MCP server that hands any AI agent a budget-bound wallet). It also does x402 discovery, so endpoints can be registered on open indexes and found by agents.`,
  },
  {
    q: `What is x402?`,
    a: `x402 revives the dormant HTTP 402 "Payment Required" status code as a real payment protocol. A server answers a request with 402 plus a machine-readable challenge (price, token, chain, pay-to address); the caller pays on-chain and retries with proof, and the request goes through. It lets an HTTP endpoint charge for itself — no API keys, accounts, or invoices — which is exactly what AI agents need to pay for data and compute autonomously.`,
  },
  {
    q: `How do AI agents pay for APIs with PipRail?`,
    a: `Wrap the agent's HTTP calls with PipRailClient. Give it a wallet and a chain, then call client.fetch(url): on a 402 it reads the challenge, sends the payment on-chain, waits for confirmation, and retries with proof — automatically. An opt-in spend policy (maxAmount, maxTotal, chains, tokens, hosts) refuses out-of-bounds calls before any send, and paymentTools(client) hands the same to an LLM via MCP or function-calling — budget-bound so it can't overspend.`,
  },
  {
    q: `How do I let Claude or Cursor pay for things autonomously?`,
    a: `Install the PipRail MCP server: add a small config block to your MCP client (Claude Desktop, Cursor, Claude Code, Windsurf, VS Code, or Cline) that runs "npx -y @piprail/mcp" with your wallet key, chain, and spend caps. The agent gains seven tools — piprail_discover (find payable APIs), piprail_quote_payment, piprail_plan_payment, piprail_pay_request, piprail_register (list its own), piprail_budget (read its remaining budget), and piprail_guide (the agent contract) — so it finds and pays x402-gated APIs on its own across ${total} chains. It runs locally with your own wallet, and the spend policy is enforced before any on-chain send, so the model literally cannot overspend.`,
  },
  {
    q: `Which chains and tokens does PipRail support?`,
    a: `${total} chains across ${familyCount} families: ${evmCount} EVM mainnets (Ethereum, Base, Arbitrum, Optimism, Polygon, BNB Chain, Avalanche, HyperEVM, Monad, Mantle, Sonic, Linea, Scroll, Celo, zkSync, Unichain, World Chain, Sei, Injective, Kaia) plus Solana, TON, Tron, NEAR, Sui, Aptos, Algorand, Stellar, and the XRP Ledger. USDC almost everywhere, USDT on most chains, EURC on Stellar, RLUSD on XRPL, the native coin on every chain, or any other token by address. One parameter — chain — picks everything.`,
  },
  {
    q: `Is there a fee to use PipRail?`,
    a: `No. PipRail charges no fee and takes no cut. It's an open-source (MIT) npm package, not a platform or hosted service. Payments settle straight into your own wallet — there's no PipRail backend, facilitator, or middleman in the path. You pay only normal network gas on whichever chain you choose.`,
  },
  {
    q: `Can any x402 client pay a PipRail endpoint?`,
    a: `Yes. PipRail's wire envelope is x402 v2-conformant, and a gate can opt into advertising the ratified "exact" (EIP-3009) scheme alongside its default backendless "onchain-proof" rail. A standard x402 client (Coinbase's, the open-source reference client) picks the exact rail; a PipRail client picks onchain-proof — both offered in the same 402. Settlement stays backendless either way: your own relayer key broadcasts the signed authorization, or you delegate to a third-party facilitator you choose, so the payer spends no gas and PipRail hosts nothing. It's verified end-to-end against the official x402 reference client on Base mainnet. The standard exact rail is EVM + EIP-3009 tokens (USDC/EURC) today; every other chain and token is paid via onchain-proof, which is itself x402.`,
  },
]
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': 'https://piprail.com/#faq',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}

// Compact 402-loop HowTo (the canonical full version lives on /sdk).
const howToLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  '@id': 'https://piprail.com/#howto',
  name: 'How an x402 payment works with PipRail',
  description: 'The four-step 402 loop: request, 402 challenge, pay on-chain, verify locally and serve.',
  step: steps.map((s) => ({ '@type': 'HowToStep', name: s.t, text: s.d })),
}
---

<Layout title={title} description={description}>
  <Navigation path="/" />

  <main class="mx-auto max-w-6xl px-4 sm:px-6">
    <!-- 1 · Hero -->
    <section class="fade-up py-16 text-center sm:py-20 md:py-28">
      <p class="mb-7 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3.5 py-1.5 text-xs text-muted">
        <span class="h-1.5 w-1.5 rounded-full bg-accent animate-pulse"></span>
        Open x402 standard · verified live on mainnet
      </p>
      <h1 class="mx-auto max-w-4xl text-[2.5rem] font-semibold leading-[1.05] tracking-tight sm:text-6xl md:text-7xl">
        The universal payment rail for the
        <span class="text-accent">agent economy</span>.
      </h1>
      <p class="mx-auto mt-6 max-w-xl text-base leading-relaxed text-neutral-400 sm:text-lg md:text-xl">
        Any API <span class="text-neutral-200">charges for itself</span> — any AI agent
        <span class="text-neutral-200">pays on its own</span>. One line, every chain, straight to your wallet.
        No backend, no fee.
      </p>

      <!-- dual CTA — route the two audiences -->
      <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href="/sdk" class="inline-flex w-full items-center justify-center gap-2 cta-glow rounded-xl bg-accent px-6 py-3.5 text-sm font-semibold text-neutral-950 transition hover:brightness-110 sm:w-auto">
          <Code2 size={16} aria-hidden="true" /> Get paid — the SDK
        </a>
        <a href="/mcp" class="inline-flex w-full items-center justify-center gap-2 rounded-xl border border-white/10 bg-white/5 px-6 py-3.5 text-sm font-semibold text-neutral-200 transition hover:border-white/20 sm:w-auto">
          <Bot size={16} class="text-accent" aria-hidden="true" /> Give your agent a wallet
        </a>
      </div>
      <div class="mt-4 inline-flex items-center gap-3 rounded-xl border border-white/10 bg-neutral-900/80 px-5 py-3 font-mono text-sm">
        <span class="select-none text-neutral-600">$</span>
        <span class="truncate">npm install @piprail/sdk viem</span>
      </div>

      <!-- chain strip — two-lane animated marquee, edge-faded, BNB first -->
      <div class="mt-14 sm:mt-16">
        <p class="mb-7 text-[11px] uppercase tracking-[0.2em] text-neutral-600">Live on every major chain</p>
        <div class="space-y-3 sm:space-y-4">
          <div class="marquee overflow-hidden py-1">
            <div class="marquee-track left">
              {[...marqueeA, ...marqueeA].map((c, i) => (
                <div aria-hidden={i >= marqueeA.length} class="mr-3 flex shrink-0 flex-col items-center gap-2 rounded-xl border border-white/8 bg-white/3 px-4 py-3 transition hover:border-accent/30 hover:bg-white/5 sm:px-5 sm:py-3.5">
                  <img src={`/chains/${c.slug}.svg`} alt={`${c.name} logo`} width="36" height="36" class="h-8 w-8 rounded-full ring-1 ring-white/10 sm:h-9 sm:w-9" />
                  <span class="whitespace-nowrap text-[11px] font-medium text-neutral-400 sm:text-xs">{c.name}</span>
                </div>
              ))}
            </div>
          </div>
          <div class="marquee overflow-hidden py-1">
            <div class="marquee-track right">
              {[...marqueeB, ...marqueeB].map((c, i) => (
                <div aria-hidden={i >= marqueeB.length} class="mr-3 flex shrink-0 flex-col items-center gap-2 rounded-xl border border-white/8 bg-white/3 px-4 py-3 transition hover:border-accent/30 hover:bg-white/5 sm:px-5 sm:py-3.5">
                  <img src={`/chains/${c.slug}.svg`} alt={`${c.name} logo`} width="36" height="36" class="h-8 w-8 rounded-full ring-1 ring-white/10 sm:h-9 sm:w-9" />
                  <span class="whitespace-nowrap text-[11px] font-medium text-neutral-400 sm:text-xs">{c.name}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 2 · The story — the universal payment adapter -->
    <section id="story" aria-label="What PipRail is" class="scroll-mt-24 py-12 sm:py-16">
      <div class="mx-auto max-w-3xl text-center">
        <span class="inline-flex items-center rounded-full border border-accent/25 bg-accent/8 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.15em] text-accent">The universal payment adapter</span>
        <h2 class="mt-5 text-3xl font-semibold leading-[1.12] tracking-tight sm:text-4xl">
          Money online was built for humans.<br class="hidden sm:block" />
          <span class="text-accent">PipRail rebuilds it for agents.</span>
        </h2>
        <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-neutral-400 sm:text-lg">
          AI agents now earn and spend on their own — buying data, paying for compute, selling their work. But money
          online still assumes a human with a credit card, scattered across dozens of blockchains that each settle
          differently. An agent can’t swipe a card, and no endpoint can charge across them all.
        </p>
      </div>

      <!-- the adapter, visualized: a fragmented world → PipRail → any agent ⇄ any API -->
      <div class="mt-12 flex flex-col items-stretch gap-3 sm:mt-14 sm:flex-row sm:items-center sm:gap-0">
        <!-- the problem: many chains, all different -->
        <div class="card flex-1 rounded-2xl p-5 text-center sm:p-6">
          <p class="text-[11px] font-semibold uppercase tracking-wider text-neutral-500">The fragmented world</p>
          <div class="mt-3.5 flex flex-wrap items-center justify-center gap-2">
            {fragmentLogos.map((slug) => (
              <img src={`/chains/${slug}.svg`} alt="" width="30" height="30" class="h-7 w-7 rounded-full ring-1 ring-white/10 opacity-80" />
            ))}
          </div>
          <p class="mt-3.5 text-sm leading-snug text-neutral-400">{total} chains — each its own tokens, signing &amp; gas</p>
        </div>

        <!-- connector → -->
        <div class="hidden h-px sm:mx-1 sm:flex sm:w-14 sm:items-center">
          <div class="h-px w-full bg-linear-to-r from-white/10 via-accent/50 to-accent/90"></div>
        </div>

        <!-- the adapter: PipRail in the middle -->
        <div class="relative flex-1 overflow-hidden rounded-2xl border border-accent/30 bg-linear-to-b from-accent/10 to-white/2 p-6 text-center shadow-[0_0_56px_-14px_rgba(46,230,166,0.5)]">
          <div class="pointer-events-none absolute left-1/2 top-1/2 h-44 w-44 -translate-x-1/2 -translate-y-1/2 rounded-full bg-accent/15 blur-3xl"></div>
          <div class="relative">
            <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl border border-accent/30 bg-neutral-950 shadow-[inset_0_1px_0_rgba(255,255,255,0.1)]">
              <img src="/logo.png" alt="PipRail" width="34" height="34" class="h-8.5 w-8.5" />
            </div>
            <p class="mt-3.5 font-display text-lg font-semibold tracking-tight text-white">PipRail</p>
            <p class="mt-1 text-sm font-medium text-accent">one adapter · one line</p>
          </div>
        </div>

        <!-- connector → -->
        <div class="hidden h-px sm:mx-1 sm:flex sm:w-14 sm:items-center">
          <div class="h-px w-full bg-linear-to-r from-accent/90 via-accent/50 to-white/10"></div>
        </div>

        <!-- the payoff: any API ⇄ any agent -->
        <div class="card flex-1 rounded-2xl p-5 text-center sm:p-6">
          <p class="text-[11px] font-semibold uppercase tracking-wider text-accent">The payoff</p>
          <div class="mt-3.5 flex items-center justify-center gap-2 text-sm">
            <span class="rounded-lg border border-white/10 bg-white/5 px-2.5 py-1.5 font-medium text-neutral-200">Any API</span>
            <span class="text-accent">⇄</span>
            <span class="rounded-lg border border-white/10 bg-white/5 px-2.5 py-1.5 font-medium text-neutral-200">Any agent</span>
          </div>
          <p class="mt-3.5 text-sm leading-snug text-neutral-400">charges for itself · pays on its own</p>
        </div>
      </div>

      <!-- the resolution + the proof, woven in -->
      <p class="mx-auto mt-10 max-w-2xl text-center text-base leading-relaxed text-neutral-300 sm:text-lg">
        Name a chain — PipRail handles the token, the signing, the proof.
        <span class="text-white">One line, every chain, straight to your wallet.</span> No backend, no facilitator, no fee.
      </p>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-sm text-neutral-500">
        <span><span class="font-semibold text-neutral-200">{total}</span> chains</span>
        <span class="text-white/15" aria-hidden="true">·</span>
        <span><span class="font-semibold text-neutral-200">$0</span> fee</span>
        <span class="text-white/15" aria-hidden="true">·</span>
        <span><span class="font-semibold text-neutral-200">1</span> line</span>
        <span class="text-white/15" aria-hidden="true">·</span>
        <span><span class="font-semibold text-neutral-200">MIT</span> open source</span>
      </div>
    </section>

    <!-- 3 · The fork — two audiences, two doors -->
    <section class="py-20 sm:py-24">
      <SectionHeading title="Two sides, one SDK." class="mb-10 max-w-2xl sm:mb-12">
        The same package lets a server <span class="text-neutral-200">charge</span> for a route and an agent
        <span class="text-neutral-200">pay</span> for one. Pick your side — both are a couple of lines.
      </SectionHeading>
      <div class="grid gap-6 lg:grid-cols-2">
        <div class="flex min-w-0 flex-col card rounded-2xl p-6 sm:p-7">
          <h3 class="flex items-center gap-2 text-sm font-medium uppercase tracking-wider text-muted">
            <span class="h-1.5 w-1.5 rounded-full bg-accent"></span> Accept — your server gets paid
          </h3>
          <p class="mt-2 mb-4 text-sm leading-relaxed text-neutral-400">Gate any route so it charges for itself. Express, Next.js, or any edge runtime — no backend, no database.</p>
          <CodeWindow file="server.ts" code={acceptCode} class="min-w-0" />
          <a href="/sdk" class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-accent transition hover:gap-2.5">Build a paid API <ArrowRight size={15} aria-hidden="true" /></a>
        </div>
        <div class="flex min-w-0 flex-col card rounded-2xl p-6 sm:p-7">
          <h3 class="flex items-center gap-2 text-sm font-medium uppercase tracking-wider text-muted">
            <span class="h-1.5 w-1.5 rounded-full bg-accent"></span> Pay — your agent pays for itself
          </h3>
          <p class="mt-2 mb-4 text-sm leading-relaxed text-neutral-400">Point an agent at a paid URL and it pays the 402 on its own — inside a budget it can’t exceed.</p>
          <CodeWindow file="agent.ts" code={payCode} class="min-w-0" />
          <a href="/mcp" class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-accent transition hover:gap-2.5">Give your agent a wallet <ArrowRight size={15} aria-hidden="true" /></a>
        </div>
      </div>
    </section>

    <!-- 4 · Live demo teaser -->
    <section aria-label="Live demo" class="relative overflow-hidden rounded-3xl border border-accent/20 bg-linear-to-br from-accent/8 via-white/2 to-transparent p-8 sm:p-10 lg:p-14">
      <div class="pointer-events-none absolute -right-24 -top-28 h-80 w-80 rounded-full bg-accent/10 blur-3xl"></div>
      <div class="relative grid items-center gap-10 lg:grid-cols-[1.05fr_1fr] lg:gap-14">
        <div>
          <span class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.18em] text-accent">
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-75"></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-accent"></span>
            </span>
            Live demo
          </span>
          <h2 class="mt-4 text-3xl font-semibold leading-[1.1] tracking-tight sm:text-4xl">
            Don’t take our word for it.<br class="hidden sm:block" />
            <span class="text-accent">Run it in your browser.</span>
          </h2>
          <p class="mt-4 max-w-xl text-base leading-relaxed text-neutral-400 sm:text-lg">
            Build a real <span class="font-mono text-neutral-200">402</span> challenge and watch an agent price it —
            live, client-side, no install. The SDK loads from a CDN right on the page.
          </p>
          <div class="mt-8">
            <a href="/demo" class="inline-flex items-center justify-center gap-2 cta-glow rounded-xl bg-accent px-6 py-3.5 text-sm font-semibold text-neutral-950 transition hover:brightness-110">
              <Play size={15} fill="currentColor" aria-hidden="true" /> Try the live demo
            </a>
          </div>
        </div>
        <div class="relative">
          <div class="overflow-hidden rounded-xl border border-white/10 bg-neutral-900/80 shadow-2xl shadow-black/40">
            <div class="flex items-center gap-1.5 border-b border-white/5 px-4 py-2.5">
              <span class="h-2.5 w-2.5 rounded-full bg-white/10"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-white/10"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-white/10"></span>
              <span class="ml-2 truncate font-mono text-xs text-neutral-500">piprail.com/demo</span>
            </div>
            <div class="space-y-3 p-4 font-mono text-[11.5px] leading-relaxed sm:text-[12.5px]">
              <div><span class="rounded bg-rose-500/15 px-1.5 py-0.5 text-[10px] font-semibold text-rose-300">402</span> <span class="text-neutral-500">Payment Required · Base · USDC</span></div>
              <pre class="overflow-hidden rounded-lg bg-black/30 p-3 text-neutral-300">{`{
  "amount": "50000",
  "asset":  "0x8335…2913",
  "payTo":  "0xYourWallet"
}`}</pre>
              <div class="flex items-center justify-between rounded-lg border border-accent/20 bg-accent/8 px-3 py-2.5">
                <span class="text-neutral-400">🤖 agent pays</span>
                <span class="font-semibold text-accent">0.05 USDC ✓</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 5 · Why PipRail -->
    <section class="border-t border-white/10 py-20 sm:py-24">
      <SectionHeading title="One protocol. Every chain.">
        One x402 line, one self-custodial driver per family — the same integration pays and gets paid across all
        {familyCount} families, native coin or stablecoin. And PipRail reaches chains no other x402 SDK touches:
        TON, Tron, NEAR, Sui, Aptos, Algorand, Stellar &amp; the XRP Ledger, alongside every major EVM chain.
      </SectionHeading>

      <div id="coverage" class="lift relative mb-4 overflow-hidden rounded-2xl border border-white/10 bg-neutral-950/80 p-6 sm:p-8">
        <!-- emerald wash -->
        <div class="pointer-events-none absolute -right-24 -top-28 h-72 w-72 rounded-full bg-accent/10 blur-3xl"></div>
