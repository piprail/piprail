---
import Layout from '../layouts/Layout.astro'
import Navigation from '../components/Navigation.astro'
import Footer from '../components/Footer.astro'
import CodeWindow from '../components/CodeWindow.astro'
import SectionHeading from '../components/SectionHeading.astro'
import { chains } from '../data/chains'
import { acceptCode, payCode, mcpConfigCode } from '../data/snippets'
import {
  Zap, Coins, ShieldCheck, PackageCheck, Boxes, Percent, Code2, Scale,
  ArrowRight, Globe, ChevronDown, Play, Bot, Plug, Wallet, Sparkles, Handshake,
  Search, Megaphone,
} from 'lucide-astro'

// Counts are DERIVED from the chain data — never hardcoded, so nothing can drift.
const total = chains.length
const familyCount = [...new Set(chains.map((c) => c.family))].length
const evmCount = chains.filter((c) => c.family === 'EVM').length

// Concise, front-loaded, count-derived meta — the homepage is the brand anchor.
const title = 'PipRail — x402 crypto payments for AI agents, every chain'
const description = `Accept x402 crypto payments on ${total} chains — or hand your AI agent a wallet to pay on its own. One line, USDC/USDT/native straight to your wallet. No backend, no fee, MIT.`

const stats = [
  { icon: Boxes, v: String(total), l: 'chains built in' },
  { icon: Percent, v: '0', l: 'protocol fee' },
  { icon: Code2, v: '1', l: 'line to integrate' },
  { icon: Scale, v: 'MIT', l: 'open source' },
]

const why = [
  { icon: Globe, t: 'Widest coverage in x402', d: `${total} chains across ${familyCount} families, with native, self-custodial drivers — the only package that reaches TON, Tron, NEAR, Sui, Aptos, Algorand, and the XRP Ledger together.` },
  { icon: ShieldCheck, t: 'Backendless by default', d: 'No facilitator, no relayer, no protocol fee. The payer broadcasts their own transfer, and you verify it against your own RPC — where most x402 stacks settle through a third party.' },
  { icon: Zap, t: 'One line, zero infra', d: 'npm install, name a chain, add a wallet. Nothing to sign up for, deploy, or host — you’re charging agents in minutes.' },
]

const steps = [
  { icon: Zap, n: '01', t: 'Agent calls your route', d: 'It gets back a 402 quote — price, token, payTo, chain.' },
  { icon: Coins, n: '02', t: 'Agent pays on-chain', d: 'One transfer, straight to your wallet. PipRail never touches the funds.' },
  { icon: ShieldCheck, n: '03', t: 'You verify locally', d: 'Your server checks the tx against your own RPC: succeeded, recent, right amount + recipient.' },
  { icon: PackageCheck, n: '04', t: 'You return the data', d: '200 OK — and the same proof can never be spent twice.' },
]

// Representative logo per family — EVM stands for all its mainnets behind one driver.
const familyLogos = [
  { slug: 'ethereum', label: `EVM ×${evmCount}` },
  { slug: 'solana', label: 'Solana' }, { slug: 'ton', label: 'TON' }, { slug: 'tron', label: 'Tron' },
  { slug: 'near', label: 'NEAR' }, { slug: 'sui', label: 'Sui' }, { slug: 'aptos', label: 'Aptos' },
  { slug: 'algorand', label: 'Algorand' }, { slug: 'stellar', label: 'Stellar' }, { slug: 'xrpl', label: 'XRPL' },
]

const mcpTools = [
  { name: 'piprail_discover', desc: 'find payable APIs on the open indexes — the phone book' },
  { name: 'piprail_quote_payment', desc: 'price a gated URL — without paying' },
  { name: 'piprail_plan_payment', desc: 'check it can afford it: balance, gas, recipient-readiness' },
  { name: 'piprail_pay_request', desc: 'fetch it, paying the 402 automatically' },
  { name: 'piprail_register', desc: 'list an endpoint you run so other agents find it' },
]

// Top 5 questions only — the rest live on /sdk, /mcp, /chains (each with its own schema).
const faqs = [
  {
    q: `What is x402?`,
    a: `x402 revives the dormant HTTP 402 "Payment Required" status code as a real payment protocol. A server answers a request with 402 plus a machine-readable challenge (price, token, chain, pay-to address); the caller pays on-chain and retries with proof, and the request goes through. It lets an HTTP endpoint charge for itself — no API keys, accounts, or invoices — which is exactly what AI agents need to pay for data and compute autonomously.`,
  },
  {
    q: `How do AI agents pay for APIs with PipRail?`,
    a: `Wrap the agent's HTTP calls with PipRailClient. Give it a wallet and a chain, then call client.fetch(url): on a 402 it reads the challenge, sends the payment on-chain, waits for confirmation, and retries with proof — automatically. An opt-in spend policy (maxAmount, maxTotal, chains, tokens, hosts) refuses out-of-bounds calls before any send, and paymentTools(client) hands the same to an LLM via MCP or function-calling — budget-bound so it can't overspend.`,
  },
  {
    q: `How do I let Claude or Cursor pay for things autonomously?`,
    a: `Install the PipRail MCP server: add a small config block to your MCP client (Claude Desktop, Cursor, Claude Code, Windsurf, VS Code, or Cline) that runs "npx -y @piprail/mcp" with your wallet key, chain, and spend caps. The agent gains five tools — piprail_discover (find payable APIs), piprail_quote_payment, piprail_plan_payment, piprail_pay_request, and piprail_register (list its own) — so it finds and pays x402-gated APIs on its own across ${total} chains. It runs locally with your own wallet, and the spend policy is enforced before any on-chain send, so the model literally cannot overspend.`,
  },
  {
    q: `Which chains and tokens does PipRail support?`,
    a: `${total} chains across ${familyCount} families: ${evmCount} EVM mainnets (Ethereum, Base, Arbitrum, Optimism, Polygon, BNB Chain, Avalanche, HyperEVM, Monad, Mantle, Sonic, Linea, Scroll, Celo, zkSync, Unichain, World Chain, Sei, Injective) plus Solana, TON, Tron, NEAR, Sui, Aptos, Algorand, Stellar, and the XRP Ledger. USDC almost everywhere, USDT on most chains, EURC on Stellar, RLUSD on XRPL, the native coin on every chain, or any other token by address. One parameter — chain — picks everything.`,
  },
  {
    q: `Is there a fee to use PipRail?`,
    a: `No. PipRail charges no fee and takes no cut. It's an open-source (MIT) npm package, not a platform or hosted service. Payments settle straight into your own wallet — there's no PipRail backend, facilitator, or middleman in the path. You pay only normal network gas on whichever chain you choose.`,
  },
]
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': 'https://piprail.com/#faq',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}

// Compact 402-loop HowTo (the canonical full version lives on /sdk).
const howToLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  '@id': 'https://piprail.com/#howto',
  name: 'How an x402 payment works with PipRail',
  description: 'The four-step 402 loop: request, 402 challenge, pay on-chain, verify locally and serve.',
  step: steps.map((s) => ({ '@type': 'HowToStep', name: s.t, text: s.d })),
}
---

<Layout title={title} description={description}>
  <Navigation path="/" />

  <main class="mx-auto max-w-6xl px-4 sm:px-6">
    <!-- 1 · Hero -->
    <section class="fade-up py-16 text-center sm:py-20 md:py-28">
      <p class="mb-7 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3.5 py-1.5 text-xs text-muted">
        <span class="h-1.5 w-1.5 rounded-full bg-accent animate-pulse"></span>
        Open x402 standard · verified live on mainnet
      </p>
      <h1 class="mx-auto max-w-4xl text-[2.5rem] font-semibold leading-[1.05] tracking-tight sm:text-6xl md:text-7xl">
        The payment layer for the
        <span class="text-accent">agent economy</span>.
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-base leading-relaxed text-neutral-400 sm:text-lg md:text-xl">
        Accept x402 crypto payments on every chain — or hand your AI agent a wallet to pay on its own.
        One line, <span class="text-neutral-200">{total} chains</span>, USDC/USDT/native straight to your wallet.
        No middleman, no account, no fee.
      </p>

      <!-- dual CTA — route the two audiences -->
      <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href="/sdk" class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-accent px-6 py-3.5 text-sm font-semibold text-neutral-950 transition hover:brightness-110 sm:w-auto">
          <Code2 size={16} aria-hidden="true" /> Get paid — the SDK
        </a>
        <a href="/mcp" class="inline-flex w-full items-center justify-center gap-2 rounded-xl border border-white/10 bg-white/5 px-6 py-3.5 text-sm font-semibold text-neutral-200 transition hover:border-white/20 sm:w-auto">
          <Bot size={16} class="text-accent" aria-hidden="true" /> Give your agent a wallet
        </a>
      </div>
      <div class="mt-4 inline-flex items-center gap-3 rounded-xl border border-white/10 bg-neutral-900/80 px-5 py-3 font-mono text-sm">
        <span class="select-none text-neutral-600">$</span>
        <span class="truncate">npm install @piprail/sdk viem</span>
      </div>

      <!-- chain strip -->
      <div class="mt-14 sm:mt-16">
        <p class="mb-6 text-[11px] uppercase tracking-[0.2em] text-neutral-600">Live on every major chain</p>
        <div class="mx-auto flex max-w-3xl flex-wrap items-center justify-center gap-x-7 gap-y-5 sm:gap-x-9">
          {chains.map((c) => (
            <img src={`/chains/${c.slug}.svg`} alt={`${c.name} logo`} width="28" height="28" loading="lazy"
              class="h-7 w-7 rounded-full ring-1 ring-white/10 opacity-90 transition hover:scale-110 hover:opacity-100" />
          ))}
        </div>
      </div>
    </section>

    <!-- 2 · Stats bar -->
    <section aria-label="At a glance" class="grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-white/10 bg-white/10 md:grid-cols-4">
      {stats.map((s) => {
        const Icon = s.icon
        return (
          <div class="bg-neutral-950 px-5 py-7 text-center transition-colors hover:bg-neutral-900/60">
            <Icon size={18} class="mx-auto mb-3 text-accent/70" aria-hidden="true" />
            <p class="text-3xl font-semibold tracking-tight text-neutral-100 md:text-4xl">{s.v}</p>
            <p class="mt-1.5 text-sm text-neutral-400">{s.l}</p>
          </div>
        )
      })}
    </section>

    <!-- 3 · The fork — two audiences, two doors -->
    <section class="py-20 sm:py-24">
      <SectionHeading title="Two sides, one SDK." class="mb-10 max-w-2xl sm:mb-12">
        The same package lets a server <span class="text-neutral-200">charge</span> for a route and an agent
        <span class="text-neutral-200">pay</span> for one. Pick your side — both are a couple of lines.
      </SectionHeading>
      <div class="grid gap-6 lg:grid-cols-2">
        <div class="flex min-w-0 flex-col rounded-2xl border border-white/10 bg-white/2 p-6 sm:p-7">
          <h3 class="flex items-center gap-2 text-sm font-medium uppercase tracking-wider text-muted">
            <span class="h-1.5 w-1.5 rounded-full bg-accent"></span> Accept — your server gets paid
          </h3>
          <p class="mt-2 mb-4 text-sm leading-relaxed text-neutral-400">Gate any route so it charges for itself. Express, Next.js, or any edge runtime — no backend, no database.</p>
          <CodeWindow file="server.ts" code={acceptCode} class="min-w-0" />
          <a href="/sdk" class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-accent transition hover:gap-2.5">Build a paid API <ArrowRight size={15} aria-hidden="true" /></a>
        </div>
        <div class="flex min-w-0 flex-col rounded-2xl border border-white/10 bg-white/2 p-6 sm:p-7">
          <h3 class="flex items-center gap-2 text-sm font-medium uppercase tracking-wider text-muted">
            <span class="h-1.5 w-1.5 rounded-full bg-accent"></span> Pay — your agent pays for itself
          </h3>
          <p class="mt-2 mb-4 text-sm leading-relaxed text-neutral-400">Point an agent at a paid URL and it pays the 402 on its own — inside a budget it can’t exceed.</p>
          <CodeWindow file="agent.ts" code={payCode} class="min-w-0" />
          <a href="/mcp" class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-accent transition hover:gap-2.5">Give your agent a wallet <ArrowRight size={15} aria-hidden="true" /></a>
        </div>
      </div>
    </section>

    <!-- 4 · Live demo teaser -->
    <section aria-label="Live demo" class="relative overflow-hidden rounded-3xl border border-accent/20 bg-linear-to-br from-accent/8 via-white/2 to-transparent p-8 sm:p-10 lg:p-14">
      <div class="pointer-events-none absolute -right-24 -top-28 h-80 w-80 rounded-full bg-accent/10 blur-3xl"></div>
      <div class="relative grid items-center gap-10 lg:grid-cols-[1.05fr_1fr] lg:gap-14">
        <div>
          <span class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.18em] text-accent">
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-75"></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-accent"></span>
            </span>
            Live demo
          </span>
          <h2 class="mt-4 text-3xl font-semibold leading-[1.1] tracking-tight sm:text-4xl">
            Don’t take our word for it.<br class="hidden sm:block" />
            <span class="text-accent">Run it in your browser.</span>
          </h2>
          <p class="mt-4 max-w-xl text-base leading-relaxed text-neutral-400 sm:text-lg">
            Build a real <span class="font-mono text-neutral-200">402</span> challenge and watch an agent price it —
            live, client-side, no install. The SDK loads from a CDN right on the page.
          </p>
          <div class="mt-8">
            <a href="/demo" class="inline-flex items-center justify-center gap-2 rounded-xl bg-accent px-6 py-3.5 text-sm font-semibold text-neutral-950 transition hover:brightness-110">
              <Play size={15} fill="currentColor" aria-hidden="true" /> Try the live demo
            </a>
          </div>
        </div>
        <div class="relative">
          <div class="overflow-hidden rounded-xl border border-white/10 bg-neutral-900/80 shadow-2xl shadow-black/40">
            <div class="flex items-center gap-1.5 border-b border-white/5 px-4 py-2.5">
              <span class="h-2.5 w-2.5 rounded-full bg-white/10"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-white/10"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-white/10"></span>
              <span class="ml-2 truncate font-mono text-xs text-neutral-500">piprail.com/demo</span>
            </div>
            <div class="space-y-3 p-4 font-mono text-[11.5px] leading-relaxed sm:text-[12.5px]">
              <div><span class="rounded bg-rose-500/15 px-1.5 py-0.5 text-[10px] font-semibold text-rose-300">402</span> <span class="text-neutral-500">Payment Required · Base · USDC</span></div>
              <pre class="overflow-hidden rounded-lg bg-black/30 p-3 text-neutral-300">{`{
  "amount": "50000",
  "asset":  "0x8335…2913",
  "payTo":  "0xYourWallet"
}`}</pre>
              <div class="flex items-center justify-between rounded-lg border border-accent/20 bg-accent/8 px-3 py-2.5">
                <span class="text-neutral-400">🤖 agent pays</span>
                <span class="font-semibold text-accent">0.05 USDC ✓</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 5 · Why PipRail -->
    <section class="border-t border-white/10 py-20 sm:py-24">
      <SectionHeading title="One protocol. Every chain.">
        Every blockchain settles value its own way. PipRail collapses that behind a single x402 line and one
        self-custodial driver per family — so the same integration pays and gets paid across all {familyCount},
        native coin or stablecoin. Backendless, no fee, no one in the middle. No other x402 SDK reaches this far.
      </SectionHeading>

      <div class="mb-4 flex flex-wrap items-center justify-center gap-x-7 gap-y-4 rounded-2xl border border-white/10 bg-neutral-950 px-6 py-7 sm:gap-x-10">
        {familyLogos.map((f) => (
          <span class="flex items-center gap-2" title={f.label}>
            <img src={`/chains/${f.slug}.svg`} alt={`${f.label} logo`} width="28" height="28" loading="lazy" class="h-7 w-7 rounded-full ring-1 ring-white/10" />
            <span class="text-sm font-medium text-neutral-300">{f.label}</span>
          </span>
        ))}
      </div>

      <div class="grid gap-px overflow-hidden rounded-2xl border border-white/10 bg-white/10 md:grid-cols-3">
        {why.map((w) => {
          const Icon = w.icon
          return (
            <div class="bg-neutral-950 p-6 sm:p-8">
              <span class="flex h-9 w-9 items-center justify-center rounded-lg border border-white/10 bg-white/5">
                <Icon size={18} class="text-accent" aria-hidden="true" />
              </span>
              <p class="mt-4 text-lg font-medium text-neutral-100">{w.t}</p>
              <p class="mt-2 leading-relaxed text-neutral-500">{w.d}</p>
            </div>
          )
        })}
      </div>
    </section>

    <!-- 6 · How it works (compact) -->
    <section class="border-t border-white/10 py-20 sm:py-24">
      <SectionHeading title="How it works." class="mb-10 max-w-2xl">
        A four-step round trip over plain HTTP. No facilitator, no custody.
        <a href="/sdk" class="text-accent underline-offset-4 hover:underline">See the full flow →</a>
      </SectionHeading>
      <ol class="grid gap-px overflow-hidden rounded-2xl border border-white/10 bg-white/10 sm:grid-cols-2 lg:grid-cols-4">
        {steps.map((s) => {
          const Icon = s.icon
          return (
            <li class="bg-neutral-950 p-6">
              <div class="flex items-center gap-3">
                <span class="flex h-8 w-8 items-center justify-center rounded-lg border border-white/10 bg-white/5"><Icon size={16} class="text-accent" aria-hidden="true" /></span>
                <span class="font-mono text-sm text-neutral-500">{s.n}</span>
              </div>
              <p class="mt-3.5 font-medium text-neutral-100">{s.t}</p>
              <p class="mt-1.5 text-sm leading-relaxed text-neutral-500">{s.d}</p>
            </li>
          )
        })}
      </ol>
    </section>

    <!-- 7 · MCP teaser -->
    <section class="border-t border-white/10 py-20 sm:py-24">
      <div class="relative overflow-hidden rounded-3xl border border-accent/20 bg-linear-to-br from-accent/8 via-white/2 to-transparent p-8 sm:p-10 lg:p-14">
        <div class="pointer-events-none absolute -left-24 -top-28 h-80 w-80 rounded-full bg-accent/10 blur-3xl"></div>
        <div class="relative grid items-center gap-10 lg:grid-cols-[1fr_1.05fr] lg:gap-14">
          <div>
            <span class="inline-flex items-center gap-2 rounded-full border border-accent/20 bg-accent/8 px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.16em] text-accent">
              <Sparkles size={13} aria-hidden="true" /> @piprail/mcp
            </span>
            <h2 class="mt-5 text-3xl font-semibold leading-[1.1] tracking-tight sm:text-4xl">
              Give your AI agent <span class="text-accent">a wallet</span>.
            </h2>
            <p class="mt-5 max-w-xl text-base leading-relaxed text-neutral-400 sm:text-lg">
              Paste one config block and Claude Desktop, Cursor, or any MCP client pays x402-gated APIs
              <span class="text-neutral-200">on its own</span> — across {total} chains, capped by a spend policy it
              <span class="text-neutral-200">cannot exceed</span>. No code, no backend, no custody.
            </p>
            <ul class="mt-7 space-y-2.5">
              {mcpTools.map((t) => (
                <li class="flex items-start gap-3">
                  <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-md border border-accent/30 bg-accent/10 text-accent"><Plug size={12} aria-hidden="true" /></span>
                  <span class="text-sm leading-snug text-neutral-300"><code class="text-neutral-100">{t.name}</code> — {t.desc}</span>
                </li>
              ))}
            </ul>
            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
              <a href="/mcp" class="inline-flex items-center justify-center gap-2 rounded-xl bg-accent px-6 py-3.5 text-sm font-semibold text-neutral-950 transition hover:brightness-110">
                <Bot size={16} aria-hidden="true" /> Set it up
              </a>
              <a href="https://www.npmjs.com/package/@piprail/mcp" class="inline-flex items-center justify-center gap-2 rounded-xl border border-white/10 bg-white/5 px-6 py-3.5 text-sm font-semibold text-neutral-200 transition hover:border-white/20">
                @piprail/mcp on npm
              </a>
            </div>
          </div>
          <div class="min-w-0">
            <CodeWindow file="claude_desktop_config.json" code={mcpConfigCode} />
            <div class="mt-4 flex items-center gap-3 rounded-xl border border-white/10 bg-white/2 px-4 py-3">
              <Wallet size={16} class="shrink-0 text-accent" aria-hidden="true" />
              <p class="text-sm leading-snug text-neutral-400">
                <span class="font-mono text-neutral-200">npx -y @piprail/mcp</span> — nothing to install. Then say
                <span class="text-neutral-300">“pay for and summarize that report.”</span>
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 7.5 · Discoverability teaser -->
    <section class="border-t border-white/10 py-20 sm:py-24">
      <SectionHeading title="Payable isn’t the same as findable.">
        x402 lets your endpoint charge — PipRail makes it <span class="text-neutral-200">discoverable</span>, built on the
        open x402 indexes that already exist. No registry, no database, no fee — nothing PipRail-hosted. Three opt-in moves:
      </SectionHeading>
      <div class="grid gap-px overflow-hidden rounded-2xl border border-white/10 bg-white/10 md:grid-cols-3">
        <div class="bg-neutral-950 p-6 sm:p-7">
          <span class="flex h-9 w-9 items-center justify-center rounded-lg border border-white/10 bg-white/5"><Code2 size={18} class="text-accent" aria-hidden="true" /></span>
          <p class="mt-4 text-lg font-medium text-neutral-100">Emit</p>
          <p class="mt-2 leading-relaxed text-neutral-500">Turn your gate’s config into a crawlable <code class="text-neutral-300">/openapi.json</code> — a static file on your own origin.</p>
        </div>
        <div class="bg-neutral-950 p-6 sm:p-7">
          <span class="flex h-9 w-9 items-center justify-center rounded-lg border border-white/10 bg-white/5"><Megaphone size={18} class="text-accent" aria-hidden="true" /></span>
          <p class="mt-4 text-lg font-medium text-neutral-100">Register</p>
          <p class="mt-2 leading-relaxed text-neutral-500"><code class="text-neutral-300">client.register(url)</code> lists you on 402 Index — no auth, no signature, searchable in seconds.</p>
        </div>
        <div class="bg-neutral-950 p-6 sm:p-7">
          <span class="flex h-9 w-9 items-center justify-center rounded-lg border border-white/10 bg-white/5"><Search size={18} class="text-accent" aria-hidden="true" /></span>
          <p class="mt-4 text-lg font-medium text-neutral-100">Discover</p>
          <p class="mt-2 leading-relaxed text-neutral-500"><code class="text-neutral-300">client.discover(&#123; query &#125;)</code> reads the open indexes so an agent finds what to pay.</p>
        </div>
      </div>
      <div class="mt-8 text-center">
        <a href="/discovery" class="inline-flex items-center justify-center gap-2 rounded-xl border border-white/10 bg-white/5 px-6 py-3.5 text-sm font-semibold text-neutral-200 transition hover:border-white/20">
          See exactly how discoverability works <ArrowRight size={16} aria-hidden="true" />
        </a>
      </div>
    </section>

    <!-- 8 · Chains teaser -->
    <section class="border-t border-white/10 py-20 sm:py-24">
      <div class="grid items-center gap-8 lg:grid-cols-[1fr_auto]">
        <div>
          <h2 class="text-3xl font-semibold tracking-tight md:text-4xl">{total} chains, {familyCount} families.</h2>
          <p class="mt-4 max-w-xl text-base leading-relaxed text-neutral-400 sm:text-lg">
            {evmCount} EVM mainnets plus Solana, TON, Tron, NEAR, Sui, Aptos, Algorand, Stellar &amp; the XRP Ledger —
            each with its canonical stablecoins and native coin, ready to go. Any other chain works via one config object.
          </p>
          <a href="/chains" class="mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-accent transition hover:gap-2.5">Browse every chain <ArrowRight size={15} aria-hidden="true" /></a>
        </div>
        <div class="flex max-w-xs flex-wrap items-center justify-center gap-3 rounded-2xl border border-white/10 bg-neutral-950 p-6 lg:max-w-sm">
          {chains.slice(0, 12).map((c) => (
            <img src={`/chains/${c.slug}.svg`} alt={`${c.name} logo`} width="32" height="32" loading="lazy" class="h-8 w-8 rounded-full ring-1 ring-white/10" />
          ))}
          <a href="/chains" class="flex h-8 items-center rounded-full bg-white/5 px-3 text-xs font-medium text-neutral-300 ring-1 ring-white/10 transition hover:bg-white/10">+{total - 12}</a>
        </div>
      </div>
    </section>

    <!-- 9 · FAQ (top 5) -->
    <section id="faq" class="scroll-mt-20 border-t border-white/10 py-20 sm:py-24">
      <div class="grid gap-8 lg:grid-cols-[minmax(0,340px)_minmax(0,1fr)] lg:gap-16">
        <div class="lg:sticky lg:top-24 lg:self-start">
          <SectionHeading title="FAQ." class="max-w-sm">
            The essentials. More on the <a href="/sdk" class="text-accent underline-offset-4 hover:underline">SDK</a>,
            <a href="/mcp" class="text-accent underline-offset-4 hover:underline">MCP</a>, and
            <a href="/chains" class="text-accent underline-offset-4 hover:underline">Chains</a> pages.
          </SectionHeading>
        </div>
        <div class="divide-y divide-white/10 overflow-hidden rounded-2xl border border-white/10 bg-neutral-950">
          {faqs.map((f, i) => (
            <details class="group" open={i === 0}>
              <summary class="flex cursor-pointer list-none items-center justify-between gap-5 px-6 py-5 text-[15px] font-medium text-neutral-100 transition hover:bg-white/3 [&::-webkit-details-marker]:hidden sm:px-7">
                <span>{f.q}</span>
                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-white/10 text-neutral-400 transition group-open:border-accent/40 group-open:text-accent">
                  <ChevronDown size={16} class="transition-transform duration-300 group-open:rotate-180" aria-hidden="true" />
                </span>
              </summary>
              <p class="-mt-1 px-6 pb-6 text-sm leading-relaxed text-neutral-400 sm:px-7">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
      <script is:inline type="application/ld+json" set:html={JSON.stringify(faqLd)} />
    </section>

    <!-- 10 · CTA -->
    <section class="border-t border-white/10 py-24 text-center sm:py-28">
      <h2 class="mx-auto max-w-2xl text-3xl font-semibold leading-tight tracking-tight sm:text-4xl md:text-5xl">
        Get paid by agents in the next five minutes.
      </h2>
      <p class="mx-auto mt-5 max-w-xl text-base text-neutral-400 sm:text-lg">
        One install. One line. Straight to your wallet, on every chain that matters.
      </p>
      <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href="/sdk" class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-accent px-6 py-3.5 text-sm font-semibold text-neutral-950 transition hover:brightness-110 sm:w-auto">
          Read the SDK guide <ArrowRight size={16} aria-hidden="true" />
        </a>
        <a href="https://github.com/piprail/piprail" class="inline-flex w-full items-center justify-center gap-2 rounded-xl border border-white/10 bg-white/5 px-6 py-3.5 text-sm font-semibold text-neutral-200 transition hover:border-white/20 sm:w-auto">
          Star on GitHub
        </a>
      </div>
    </section>

    <!-- 11 · Partners strip -->
    <section class="border-t border-white/10 py-10">
      <a href="/partners" class="flex flex-col items-start justify-between gap-3 rounded-2xl border border-white/10 bg-white/2 px-6 py-5 transition hover:border-accent/30 hover:bg-white/5 sm:flex-row sm:items-center">
        <span class="flex items-center gap-3 text-sm text-neutral-300">
          <Handshake size={18} class="shrink-0 text-accent" aria-hidden="true" />
          <span><span class="font-medium text-neutral-100">Building on the agent economy?</span> PipRail is open to grants, chain integrations, sponsorships &amp; strategic opportunities.</span>
        </span>
        <span class="inline-flex shrink-0 items-center gap-1.5 text-sm font-medium text-accent">Partner with us <ArrowRight size={15} aria-hidden="true" /></span>
      </a>
    </section>
  </main>

  <Footer />

  <script is:inline type="application/ld+json" set:html={JSON.stringify(howToLd)} />
</Layout>
