---
import Layout from '../layouts/Layout.astro'
import Navigation from '../components/Navigation.astro'
import Footer from '../components/Footer.astro'
import CodeWindow from '../components/CodeWindow.astro'
import SectionHeading from '../components/SectionHeading.astro'
import FeatureGrid from '../components/FeatureGrid.astro'
import { chains } from '../data/chains'
import {
  acceptCode, payCode, oneParamCode, exoticCode, solanaCode, agentSafeCode, multiAcceptCode, tonCode, planCode,
} from '../data/snippets'
import {
  Zap, Coins, ShieldCheck, PackageCheck,
  Boxes, Percent, Code2, Scale, ArrowRight, Globe, ChevronDown, Play,
  Handshake, Puzzle, Landmark, Mail, Bot, Plug, Wallet, Sparkles,
} from 'lucide-astro'

import { mcpConfigCode } from '../data/snippets'

// @piprail/mcp — the three tools an MCP client gets, and the clients it drops into.
const mcpTools = [
  { name: 'piprail_quote_payment', desc: 'price a gated URL — without paying' },
  { name: 'piprail_plan_payment', desc: 'check it can afford it: balance, gas, recipient-readiness' },
  { name: 'piprail_pay_request', desc: 'fetch it, paying the 402 automatically' },
]
const mcpClients = ['Claude Desktop', 'Cursor', 'Claude Code', 'Windsurf', 'VS Code', 'Cline']

const stats = [
  { icon: Boxes, v: '28', l: 'chains built in' },
  { icon: Percent, v: '0', l: 'protocol fee' },
  { icon: Code2, v: '1', l: 'line to integrate' },
  { icon: Scale, v: 'MIT', l: 'open source' },
]

// "A tool, not a platform" — what you DON'T need.
const noNeed = [
  { label: 'No lock-in' }, { label: 'No database' }, { label: 'No account or API key' },
  { label: 'No monthly fee' }, { label: 'No contract to deploy' }, { label: 'No hosted facilitator' },
]

// Agent spend controls — the client-side guardrails.
const agentGuards = [
  { label: 'Spend limits', desc: 'per-call + lifetime caps, enforced on the token’s true decimals' },
  { label: 'Quote first', desc: 'learn the exact price without paying it' },
  { label: 'Estimate the gas', desc: 'native-coin network fee before you pay — on every chain' },
  { label: 'Approve each pay', desc: 'a final yes/no hook before any funds move' },
  { label: 'Spend ledger', desc: 'read back exactly what was spent, per token' },
  { label: 'One wallet, an LLM tool', desc: 'drop into MCP or the AI SDK — budget rides along' },
]

// planPayment — the four things it checks against your own wallet, before any send.
const planChecks = [
  { label: 'Enough token?', desc: 'your live balance of the exact payment token, per rail' },
  { label: 'Enough gas?', desc: 'the native coin to send it — you can hold USDC but no ETH' },
  { label: 'Can they receive?', desc: 'trustline / ATA / storage_deposit / ASA opt-in — before you broadcast' },
  { label: 'Within budget?', desc: 'your spend policy, all checked in one read-only call' },
]

const steps = [
  { icon: Zap, n: '01', t: 'Agent calls your route', d: 'It gets back a 402 quote — price, token, payTo, and chain.' },
  { icon: Coins, n: '02', t: 'Agent pays on-chain', d: 'One transfer, straight to your wallet. PipRail never touches the funds.' },
  { icon: ShieldCheck, n: '03', t: 'You verify locally', d: 'Your server checks the tx against your own RPC: succeeded, recent, right amount and recipient.' },
  { icon: PackageCheck, n: '04', t: 'You return the data', d: '200 OK, the gated content flows, and the same proof can never be spent twice.' },
]

// Why PipRail — the honest, defensible differentiators vs the x402 field.
const why = [
  {
    icon: Globe,
    t: 'Widest coverage in x402',
    d: '28 chains across 10 families, with native, self-custodial drivers — the only package that reaches TON, Tron, NEAR, Sui, Aptos, Algorand, and the XRP Ledger together. No other x402 SDK ships this many.',
  },
  {
    icon: ShieldCheck,
    t: 'Backendless by default',
    d: 'No facilitator, no relayer, no protocol fee. The payer broadcasts their own transfer, and you verify it against your own RPC — where most x402 stacks settle through a third-party facilitator in the middle.',
  },
  {
    icon: Zap,
    t: 'One line, zero infra',
    d: 'npm install, name a chain, add a wallet. Nothing to sign up for, deploy, or host — you’re charging agents in minutes.',
  },
]

// The ten chain families — one representative logo each — for the "one protocol,
// every chain" strip. EVM stands for all 19 EVM mainnets behind a single driver.
const familyLogos = [
  { slug: 'ethereum', label: 'EVM ×19' },
  { slug: 'solana', label: 'Solana' },
  { slug: 'ton', label: 'TON' },
  { slug: 'tron', label: 'Tron' },
  { slug: 'near', label: 'NEAR' },
  { slug: 'sui', label: 'Sui' },
  { slug: 'aptos', label: 'Aptos' },
  { slug: 'algorand', label: 'Algorand' },
  { slug: 'stellar', label: 'Stellar' },
  { slug: 'xrpl', label: 'XRPL' },
]


// FAQ — a visible Q&A that also powers the FAQPage structured data below.
// The two MUST match (search + AI engines expect schema to mirror the page).
const faqs = [
  {
    q: `What is x402?`,
    a: `x402 revives the dormant HTTP 402 "Payment Required" status code as a real payment protocol. A server answers a request with 402 plus a machine-readable challenge (price, token, chain, pay-to address); the caller pays on-chain and retries with proof, and the request goes through. It lets an HTTP endpoint charge for itself — no API keys, accounts, or invoices — which is exactly what AI agents need to pay for data and compute autonomously.`,
  },
  {
    q: `How do I accept crypto payments in Next.js?`,
    a: `Install @piprail/sdk and viem, then in a Route Handler build a gate once with createPaymentGate({ chain: 'base', token: 'USDC', amount: '0.05', payTo }) and call gate.verify(req.headers.get('payment-signature')) inside GET. If the result is 'paid', return the resource + receipt header; if 'challenge', return it with status 402; otherwise return toInvalidBody(result) with 402. No backend or database — verification runs locally against your own RPC. The same createPaymentGate pattern covers Hono, Fastify, Workers, Bun, and Deno; Express gets the requirePayment one-liner.`,
  },
  {
    q: `How do AI agents pay for APIs with PipRail?`,
    a: `Wrap the agent's HTTP calls with PipRailClient. Give it a wallet and a chain, then call client.fetch(url): on a 402 it reads the challenge, sends the payment on-chain, waits for confirmation, and retries with proof — automatically. Use client.quote(url) to learn a price without paying, client.estimateCost(url) to budget gas, and an opt-in spend policy (maxAmount, maxTotal, chains, tokens, hosts) that refuses out-of-bounds calls before any send. paymentTools(client) hands the same to an LLM via MCP, the Vercel AI SDK, or function-calling — budget-bound so it can't overspend.`,
  },
  {
    q: `How do I let Claude or Cursor pay for things autonomously?`,
    a: `Install the PipRail MCP server. Add a small config block to your MCP client (Claude Desktop, Cursor, Claude Code, Windsurf, VS Code, or Cline) that runs "npx -y @piprail/mcp" with your wallet key, chain, and spend caps. The agent gains three tools — piprail_quote_payment (price a gated URL), piprail_plan_payment (check it can afford it: balance, gas, recipient-readiness), and piprail_pay_request (pay the 402 and fetch the result) — so it can pay x402-gated APIs on its own across 28 chains. It runs locally with your own wallet, and the spend policy is enforced before any on-chain send, so the model literally cannot overspend. PipRail holds nothing and runs no backend or facilitator.`,
  },
  {
    q: `What is the PipRail MCP server (@piprail/mcp)?`,
    a: `@piprail/mcp is a Model Context Protocol (MCP) server that wraps @piprail/sdk so any MCP client can pay x402 payment-gated URLs autonomously. Run it with "npx -y @piprail/mcp" plus a wallet and a budget; it exposes piprail_quote_payment, piprail_plan_payment, and piprail_pay_request to the agent, across 28 chains. It's local-only, self-custodial, and budget-bound — no backend, no custody, no facilitator. It's how you give Claude, Cursor, or any AI agent a wallet without letting it overspend, in a couple of lines of config.`,
  },
  {
    q: `How does an agent know if it can actually pay before paying?`,
    a: `Call client.planPayment(url). It's a read-only call that surveys the 402 across every rail it offers on your chain and checks each against your own wallet: token balance, native-coin gas, and whether the recipient can even receive (trustline / associated token account / storage_deposit / ASA opt-in / account activation). It returns payable plus the best rail to use, per-rail blockers (INSUFFICIENT_TOKEN, INSUFFICIENT_GAS, RECIPIENT_NOT_READY, OUTSIDE_POLICY), and a one-sentence fundingHint telling you exactly what to top up — for example, "Have the USDC, but need ~0.00002 ETH for gas" or "Recipient must opt into the USDC ASA before it can receive." It never throws for a transient RPC failure (that rail comes back as state: 'unknown', never a false "broke"), and returns null when the URL isn't payment-gated. This completes the trio quote() → estimateCost() → planPayment(): price, gas, and whether you can actually settle it. Turn on autoRoute and client.fetch pays the cheapest settleable rail automatically; planAcross(clients, url) plans across several chains at once. No other x402 SDK does this — it's only possible because PipRail is backendless and self-custodial: it reads your balances and the chain's receive-rules directly from your own RPC, across all 28 chains, with no facilitator or oracle.`,
  },
  {
    q: `Which chains and tokens does PipRail support?`,
    a: `28 chains across 10 families: 19 EVM mainnets (Ethereum, Base, Arbitrum, Optimism, Polygon, BNB Chain, Avalanche, HyperEVM, Monad, Mantle, Sonic, Linea, Scroll, Celo, zkSync, Unichain, World Chain, Sei, Injective) plus Solana, TON, Tron, NEAR, Sui, Aptos, Algorand, Stellar, and the XRP Ledger. USDC almost everywhere, USDT on most chains, EURC on Stellar, RLUSD on XRPL, or any other token by address. One parameter — chain — picks everything.`,
  },
  {
    q: `Do any chains need extra setup before they work?`,
    a: `Most don't — on EVM, Solana, Sui, and Aptos you install, add a wallet, and pay or get paid with no extra steps, in the native coin or a stablecoin. A few chains have one-time caveats worth knowing. On Algorand, native ALGO is the zero-setup path, while receiving USDC needs a one-time ASA opt-in on the recipient (a 0-amount self-transfer, like a trustline). TON ships USD₮ (there is no native USDC on TON) and needs an API-keyed RPC — add one parameter, rpcUrl with a free toncenter API key in the URL, because the free public endpoint is rate-limited and will stall confirmation. Tron pays in USD₮ or native TRX — USD₮ is the default since TRX is volatile gas, and gas is paid in real TRX (no native USDC exists on Tron). On NEAR, native NEAR is the zero-setup path (no registration needed — a transfer even creates a fresh recipient), while paying in a NEP-141 token like USDC/USDT requires a one-time storage_deposit registration on the recipient. Stellar and the XRP Ledger require the recipient to hold a one-time trustline for the asset and to be an activated, reserve-funded account before it can receive — native XLM/XRP need no trustline. Native coin is a valid payment asset on every chain — all ten families, no exceptions. Full per-chain setup, wallet formats, and caveats are documented in CHAINS.md.`,
  },
  {
    q: `Is there a fee to use PipRail?`,
    a: `No. PipRail charges no fee and takes no cut. It's an open-source (MIT) npm package, not a platform or hosted service. Payments settle straight into your own wallet — there's no PipRail backend, facilitator, or middleman in the path. You pay only normal network gas on whichever chain you choose.`,
  },
  {
    q: `Does PipRail need a backend, database, or account?`,
    a: `None. PipRail is backendless and self-custodial: no server to run, no database, no auth, no sign-up. Payment proofs are verified locally on-chain against your own RPC, with an in-memory replay guard (pluggable to Redis for multi-instance). The x402 v2 spec explicitly lets resource servers host verification themselves, so this shape is spec-supported, not a workaround.`,
  },
  {
    q: `How do I accept several chains in one request?`,
    a: `Pass an accept array to requirePayment or createPaymentGate — one challenge that offers several chains/tokens under a shared nonce, and the agent pays with whatever it holds. Verification picks the match by network + asset and re-derives every field from its own trusted spec, so a forged echo can't redirect it and a proof can't be redeemed twice.`,
  },
  {
    q: `Can the same app both take and make payments?`,
    a: `Yes — that's the design. Use requirePayment (Express) or createPaymentGate (everything else) to charge for a route, and PipRailClient to pay for calls the same app makes outbound. Install the one package, add a wallet, and you can monetize and pay in the same process. It's pure TypeScript and runs headless or in the browser.`,
  },
]

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': 'https://piprail.com/#faq',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
}
---

<Layout>
  <Navigation path="/" />

  <main class="mx-auto max-w-6xl px-4 sm:px-6">
    <!-- Hero -->
    <section class="fade-up py-16 text-center sm:py-20 md:py-28">
      <p class="mb-7 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3.5 py-1.5 text-xs text-muted">
        <span class="h-1.5 w-1.5 rounded-full bg-accent animate-pulse"></span>
        Open x402 standard · verified live on mainnet
      </p>
      <h1 class="mx-auto max-w-4xl text-[2.5rem] font-semibold leading-[1.05] tracking-tight sm:text-6xl md:text-7xl">
        The payment layer for the
        <span class="text-accent">agent economy</span>.
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-base leading-relaxed text-neutral-400 sm:text-lg md:text-xl">
        One <span class="text-neutral-200">universal payment rail</span> for every chain — accept x402 crypto payments
        on any EVM chain, Solana, TON, Tron, NEAR, Sui, Aptos, Algorand, Stellar, and XRPL in one line.
        USDC, USDT, or the chain's native coin settles straight into your wallet. No middleman, no account, no fee.
      </p>

      <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <div class="flex w-full max-w-xs items-center gap-3 rounded-xl border border-white/10 bg-neutral-900/80 px-5 py-3.5 font-mono text-sm sm:w-auto">
          <span class="select-none text-neutral-600">$</span>
          <span class="truncate">npm install @piprail/sdk viem</span>
        </div>
        <a
          href="https://www.npmjs.com/package/@piprail/sdk"
          class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-accent px-6 py-3.5 text-sm font-semibold text-neutral-950 transition hover:brightness-110 sm:w-auto"
        >
          Get started <ArrowRight size={16} aria-hidden="true" />
        </a>
      </div>

      <!-- Chain strip -->
      <div class="mt-14 sm:mt-16">
        <p class="mb-6 text-[11px] uppercase tracking-[0.2em] text-neutral-600">Live on every major chain</p>
        <div class="mx-auto flex max-w-3xl flex-wrap items-center justify-center gap-x-7 gap-y-5 sm:gap-x-9">
          {chains.map((c) => (
            <img
              src={`/chains/${c.slug}.svg`}
              alt={`${c.name} logo`}
              width="28"
              height="28"
              loading="lazy"
              class="h-7 w-7 rounded-full ring-1 ring-white/10 opacity-90 transition hover:scale-110 hover:opacity-100"
            />
          ))}
        </div>
      </div>
    </section>

    <!-- Try the live demo -->
    <section aria-label="Live demo" class="relative overflow-hidden rounded-3xl border border-accent/20 bg-linear-to-br from-accent/8 via-white/2 to-transparent p-8 sm:p-10 lg:p-14">
      <div class="pointer-events-none absolute -right-24 -top-28 h-80 w-80 rounded-full bg-accent/10 blur-3xl"></div>
      <div class="relative grid items-center gap-10 lg:grid-cols-[1.05fr_1fr] lg:gap-14">
        <!-- copy -->
        <div>
          <span class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.18em] text-accent">
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-75"></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-accent"></span>
            </span>
            Live demo
          </span>
          <h2 class="mt-4 text-3xl font-semibold leading-[1.1] tracking-tight sm:text-4xl">
            Don’t take our word for it.<br class="hidden sm:block" />
            <span class="text-accent">Run it in your browser.</span>
          </h2>
          <p class="mt-4 max-w-xl text-base leading-relaxed text-neutral-400 sm:text-lg">
            Build a real <span class="font-mono text-neutral-200">402</span> payment challenge and watch an agent
            price it — live, client-side, across 28 chains. No install, no backend; the SDK loads from a CDN right on the page.
          </p>
          <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2.5 text-sm font-medium text-neutral-300">
            <li class="inline-flex items-center gap-2"><Globe size={16} class="text-accent" aria-hidden="true" /> Runs in your browser</li>
            <li class="inline-flex items-center gap-2"><Boxes size={16} class="text-accent" aria-hidden="true" /> 28 chains</li>
            <li class="inline-flex items-center gap-2"><Zap size={16} class="text-accent" aria-hidden="true" /> Zero install</li>
          </ul>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href="/demo" class="inline-flex items-center justify-center gap-2 rounded-xl bg-accent px-6 py-3.5 text-sm font-semibold text-neutral-950 transition hover:brightness-110">
              <Play size={15} fill="currentColor" aria-hidden="true" /> Try the live demo
            </a>
            <a href="https://github.com/piprail/piprail/tree/main/examples/browser" class="inline-flex items-center justify-center gap-2 rounded-xl border border-white/10 bg-white/5 px-6 py-3.5 text-sm font-semibold text-neutral-200 transition hover:border-white/20">
              Copy the HTML
            </a>
          </div>
        </div>
        <!-- faux-browser preview teasing the real demo -->
        <div class="relative">
          <div class="overflow-hidden rounded-xl border border-white/10 bg-neutral-900/80 shadow-2xl shadow-black/40">
            <div class="flex items-center gap-1.5 border-b border-white/5 px-4 py-2.5">
              <span class="h-2.5 w-2.5 rounded-full bg-white/10"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-white/10"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-white/10"></span>
              <span class="ml-2 truncate font-mono text-xs text-neutral-500">piprail.com/demo</span>
            </div>
            <div class="space-y-3 p-4 font-mono text-[11.5px] leading-relaxed sm:text-[12.5px]">
              <div><span class="rounded bg-rose-500/15 px-1.5 py-0.5 text-[10px] font-semibold text-rose-300">402</span> <span class="text-neutral-500">Payment Required · Base · USDC</span></div>
              <pre class="overflow-hidden rounded-lg bg-black/30 p-3 text-neutral-300">{`{
  "amount": "50000",
  "asset":  "0x8335…2913",
  "payTo":  "0xYourWallet"
}`}</pre>
              <div class="flex items-center justify-between rounded-lg border border-accent/20 bg-accent/8 px-3 py-2.5">
                <span class="text-neutral-400">🤖 agent pays</span>
                <span class="font-semibold text-accent">0.05 USDC ✓</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Stats -->
    <section aria-label="At a glance" class="mt-16 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-white/10 bg-white/10 sm:mt-24 md:grid-cols-4">
      {stats.map((s) => {
        const Icon = s.icon
        return (
          <div class="bg-neutral-950 px-5 py-8 text-center transition-colors hover:bg-neutral-900/60 sm:py-9">
            <Icon size={18} class="mx-auto mb-3 text-accent/70" aria-hidden="true" />
            <p class="text-3xl font-semibold tracking-tight text-neutral-100 md:text-4xl">{s.v}</p>
            <p class="mt-1.5 text-sm text-neutral-400">{s.l}</p>
          </div>
        )
      })}
    </section>

    <!-- Accept / Pay -->
    <section class="py-20 sm:py-24">
      <SectionHeading title="Two sides, one SDK." class="mb-10 max-w-2xl sm:mb-12">
        The same package lets a server <span class="text-neutral-200">charge</span> for a
        route and an agent <span class="text-neutral-200">pay</span> for one. Both in a
        couple of lines — on any of <span class="text-neutral-200">28 chains</span>, swap the one word.
      </SectionHeading>

      <div class="grid gap-6 lg:grid-cols-2">
        <div class="min-w-0">
          <h3 class="mb-3 flex items-center gap-2 text-xs font-medium uppercase tracking-wider text-muted">
            <span class="h-1.5 w-1.5 rounded-full bg-accent"></span> Accept — charge for any endpoint
          </h3>
          <CodeWindow file="server.ts" code={acceptCode} />
          <p class="mt-3 text-sm leading-relaxed text-neutral-500">
            Drop it into Express, Hono, Next.js, or a Cloudflare/Vercel edge function. No
            always-on backend, no database.
          </p>
        </div>
        <div class="min-w-0">
          <h3 class="mb-3 flex items-center gap-2 text-xs font-medium uppercase tracking-wider text-muted">
            <span class="h-1.5 w-1.5 rounded-full bg-accent"></span> Pay — let an agent pay for itself
          </h3>
          <CodeWindow file="agent.ts" code={payCode} />
          <p class="mt-3 text-sm leading-relaxed text-neutral-500">
            Runs anywhere JavaScript does: Node, edge, or the browser. In-browser agents and
            dapps pay client-side.
          </p>
        </div>
      </div>
    </section>

    <!-- One parameter, every chain -->
    <section class="border-t border-white/10 py-20 sm:py-24">
      <SectionHeading title="One word picks the chain.">
        Switch networks by changing a single string — from Ethereum to Solana
        to TON. Same one line, same wallet, every chain that matters.
      </SectionHeading>
      <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] lg:items-center">
        <CodeWindow code={oneParamCode} preClass="overflow-x-auto p-5 font-mono text-[12px] leading-[1.7] sm:text-sm" />
        <div class="space-y-5">
          <div class="flex flex-wrap gap-2">
            {chains.slice(0, 8).map((c) => (
              <span class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/3 px-3 py-1.5 text-sm text-neutral-300">
                <img src={`/chains/${c.slug}.svg`} alt="" width="16" height="16" loading="lazy" class="h-4 w-4 rounded-full ring-1 ring-white/10" />
                {c.name}
              </span>
            ))}
            <a href="#chains" class="inline-flex items-center gap-1 rounded-full border border-white/10 bg-white/3 px-3 py-1.5 text-sm text-neutral-400 transition hover:border-white/20 hover:text-neutral-200">
              +{chains.length - 8} more
            </a>
          </div>
          <div class="flex items-center gap-3 rounded-xl border border-white/10 bg-white/2 px-4 py-3">
            <span class="flex shrink-0 items-center">
              <img src="/tokens/usdc.svg" alt="USDC" width="24" height="24" class="h-6 w-6 rounded-full ring-1 ring-neutral-950" />
              <img src="/tokens/usdt.svg" alt="USDT" width="24" height="24" class="-ml-2 h-6 w-6 rounded-full ring-1 ring-neutral-950" />
            </span>
            <p class="text-sm leading-snug text-neutral-400">
              <span class="text-neutral-200">USDC, USDT, or the native coin</span> on every chain —
              name the token, the SDK fills in the rest.
            </p>
          </div>
        </div>
      </div>

      <!-- …or accept several at once -->
      <div class="mt-6">
        <p class="mb-3 text-xs font-medium uppercase tracking-wider text-muted">Or take several chains in one challenge</p>
        <CodeWindow code={multiAcceptCode} />
        <p class="mt-3 max-w-3xl text-sm leading-relaxed text-neutral-500">
          Offer many chains at once, and the paying agent picks the one it holds funds on — no
          per-chain routes to wire up.
        </p>
      </div>
    </section>

    <!-- Agent-safe -->
    <section class="border-t border-white/10 py-20 sm:py-24">
      <SectionHeading title="Agent-safe by default.">
        Hand an autonomous agent a wallet without losing sleep. Set a budget, and PipRail
        refuses anything outside it <span class="text-neutral-200">before a single token moves</span> —
        learn a price before paying, approve each spend, and read back exactly what went out.
      </SectionHeading>
      <div class="grid gap-6 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)] lg:items-center">
        <CodeWindow file="agent.ts" code={agentSafeCode} class="min-w-0" />
        <FeatureGrid items={agentGuards} />
      </div>
