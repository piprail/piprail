                    <span class="inline-flex items-center gap-1.5"><Wallet size={14} aria-hidden="true" /> x402</span>
                    <span class="sc-sub">self-custody</span>
                  </th>
                </tr>
              </thead>
              <tbody>
                {rows.map((r) => (
                  <tr>
