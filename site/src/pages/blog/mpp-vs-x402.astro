    .article-prose h2 { font-size: 1.9rem; }
  }
  .article-prose a {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-color: oklch(0.78 0.17 162 / 0.35);
    text-underline-offset: 3px;
    transition: text-decoration-color 0.15s ease;
  }
  .article-prose a:hover { text-decoration-color: oklch(0.78 0.17 162 / 0.9); }
  .article-prose strong { color: #fff; font-weight: 600; }
  .article-prose em { color: oklch(0.92 0.01 260); font-style: italic; }

  /* Figures */
  .article-fig { margin-block: 2.5rem; }
  .fig-eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 1.5rem;
  }
  .fig-cap {
    margin-top: 1rem;
    font-size: 0.875rem;
    font-style: italic;
    color: oklch(0.62 0.01 260);
  }

  /* Scorecard — table (≥sm) */
  .scorecard { font-size: 0.92rem; }
  .scorecard th, .scorecard td {
    padding: 0.95rem 1.1rem;
    vertical-align: top;
    border-bottom: 1px solid oklch(1 0 0 / 0.07);
    line-height: 1.5;
  }
  .scorecard tbody tr:last-child th, .scorecard tbody tr:last-child td { border-bottom: 0; }
  .scorecard thead th {
    font-weight: 700;
    border-bottom: 1px solid oklch(1 0 0 / 0.12);
    background: oklch(1 0 0 / 0.02);
  }
  .scorecard .sc-sub {
    display: block;
    margin-top: 2px;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.03em;
