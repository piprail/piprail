  /* Highlighted code blocks (Shiki <Code/>). The wrapper owns the margin + the
     rounded, bordered panel; the vitesse-dark theme supplies the bg + token colors. */
  .cb { margin: 0 0 1.5rem; }
  .cb :global(.astro-code) {
    border-radius: 0.9rem;
    border: 1px solid oklch(1 0 0 / 0.08);
    padding: 1.15rem 1.3rem;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.75;
    tab-size: 2;
    box-shadow: 0 1px 0 oklch(1 0 0 / 0.04) inset, 0 16px 34px -20px rgba(0, 0, 0, 0.85);
  }
  @media (min-width: 640px) {
    .cb :global(.astro-code) { font-size: 0.9rem; padding: 1.3rem 1.5rem; }
