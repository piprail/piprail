---
import Layout from '../../layouts/Layout.astro'
import Navigation from '../../components/Navigation.astro'
import Footer from '../../components/Footer.astro'
import Breadcrumbs from '../../components/Breadcrumbs.astro'
import { getPost, relatedPosts, formatDate } from '../../data/posts'
import { Code } from 'astro:components'
import {
  ArrowLeft, Clock, CalendarDays, Plus, Globe, Coins, Layers,
  Share2, Github, Package,
} from 'lucide-astro'

// Build-time syntax highlighting (Shiki). vitesse-dark: near-black bg that blends
// with the brand, green-leaning keywords that harmonize with the emerald accent.
const CODE_THEME = 'vitesse-dark'

const post = getPost('x402-chains')!
const site = Astro.site?.href.replace(/\/$/, '') ?? 'https://piprail.com'
const canonical = `${site}/blog/${post.slug}/`
const ogImageAbs = `${site}${post.ogImage}`
const more = relatedPosts(post.slug, 2)

const pageTitle = post.seoTitle ?? `${post.title} — PipRail`

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${canonical}#article`,
  headline: post.title,
  description: post.description,
  image: ogImageAbs,
  datePublished: post.published,
  dateModified: post.updated ?? post.published,
  author: {
    '@type': 'Person',
    name: post.author.name,
    jobTitle: 'Founder',
    url: post.author.url,
    worksFor: { '@id': 'https://piprail.com/#organization' },
  },
  publisher: { '@id': 'https://piprail.com/#organization' },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  isPartOf: { '@id': 'https://piprail.com/#website' },
  articleSection: post.category,
  keywords: post.tags.join(', '),
  inLanguage: 'en',
  wordCount: 1500,
  url: canonical,
}

const takeaways = [
  'One <span class="font-mono text-neutral-200">chain:</span> parameter picks the network, its RPC defaults, and the canonical USDC address — switching from Base to Solana is a one-word change.',
  'PipRail pays across <strong>29 chains in ten families</strong>: 20 EVM mainnets plus Solana, TON, Tron, NEAR, Sui, Aptos, Algorand, Stellar, and the XRP Ledger.',
  'USDC is available on almost every chain, the native coin on every chain, and any other token by address — chains are <em>data you pass</em>, not an allowlist the SDK ships.',
]

// Built-in EVM presets — the 20 chains you can name without passing a custom Chain.
const evm = [
  'Ethereum', 'Base', 'Arbitrum', 'Optimism', 'Polygon', 'BNB Chain', 'Avalanche',
  'HyperEVM', 'Monad', 'Mantle', 'Sonic', 'Linea', 'Scroll', 'Celo', 'zkSync',
  'Unichain', 'World Chain', 'Sei', 'Injective', 'Kaia',
]

// The nine non-EVM families: networks, the stablecoins/native each ships, and the scheme.
const families: { name: string; tokens: string; scheme: string }[] = [
  { name: 'Solana', tokens: 'USDC · USDT · SOL', scheme: 'exact + onchain-proof' },
  { name: 'NEAR', tokens: 'USDC · USDT · NEAR', scheme: 'exact + onchain-proof' },
  { name: 'Aptos', tokens: 'USDC · USDT · APT', scheme: 'exact + onchain-proof' },
  { name: 'Algorand', tokens: 'USDC · ALGO', scheme: 'exact + onchain-proof' },
  { name: 'Stellar', tokens: 'USDC · EURC · XLM', scheme: 'onchain-proof' },
  { name: 'TON', tokens: 'USDT · GRAM', scheme: 'onchain-proof' },
  { name: 'Tron', tokens: 'USDT · TRX', scheme: 'onchain-proof' },
  { name: 'Sui', tokens: 'USDC · SUI', scheme: 'onchain-proof' },
  { name: 'XRP Ledger', tokens: 'RLUSD · XRP', scheme: 'onchain-proof' },
]

const codePreset = `// A built-in preset — the canonical USDC address is pre-filled for you:
new PipRailClient({ chain: 'base', wallet: { key } })

// Switch chains by changing one word:
new PipRailClient({ chain: 'solana', wallet: { key } })

// Any other EVM chain works too — pass a viem Chain or a plain { id, rpcUrl }:
new PipRailClient({ chain: { id: 100, rpcUrl: '…' }, wallet: { key } })`

const faqs = [
  {
    q: 'How many chains does PipRail support for x402 payments?',
    a: 'Twenty-nine, across ten families. Twenty are EVM mainnets — Ethereum, Base, Arbitrum, Optimism, Polygon, BNB Chain, Avalanche, HyperEVM, Monad, Mantle, Sonic, Linea, Scroll, Celo, zkSync, Unichain, World Chain, Sei, Injective and Kaia — and nine are non-EVM families: Solana, TON, Tron, NEAR, Sui, Aptos, Algorand, Stellar and the XRP Ledger. You select any of them with a single chain: parameter, and any other EVM chain works by passing it directly.',
  },
  {
    q: 'Which chains support USDC?',
    a: 'Almost all of them. Circle-native USDC is pre-filled on nearly every EVM chain and on Solana, NEAR, Sui, Aptos and Algorand. The exceptions are chains where there is no Circle-native USDC — TON and Tron ship USDT instead, and the XRP Ledger ships RLUSD. The native coin (ETH, SOL, XRP, and so on) is a valid payment asset on every chain, and any other token works by address.',
  },
  {
    q: 'Can I pay on a chain that is not built in?',
    a: 'Yes, for any EVM chain. The built-in presets are a convenience — each ships with its canonical USDC address pre-filled — but the SDK does not gatekeep. Pass a viem Chain object or a plain { id, rpcUrl } and PipRail will pay on it. Chain details are data the caller provides, not an allowlist the SDK ships.',
  },
  {
    q: 'Does naming a non-EVM chain bloat a pure-EVM install?',
    a: 'No. The non-EVM driver libraries (for Solana, TON, NEAR, and the rest) are optional peer dependencies that lazy-load only when you actually name a non-EVM chain. A pure-EVM install never downloads them — the built EVM bundle has zero static non-EVM imports.',
  },
  {
    q: 'What is the difference between the exact scheme and onchain-proof?',
    a: 'Both are ways to prove a payment. onchain-proof is PipRail’s universal rail: the payer broadcasts their own transfer and the merchant verifies the transaction locally — it works on every chain. exact is the ratified x402 scheme, where the buyer signs an authorization and the payment can be settled gaslessly; PipRail implements it on five families (EVM, Solana, Aptos, NEAR and Algorand). Where exact is available, an agent can also pay standard x402 servers that expect it.',
  },
  {
    q: 'Which stablecoins can I accept?',
    a: 'USDC almost everywhere; USDT on most chains (omitted where the local “USDT” is a bridged token rather than Tether-native); EURC where Circle issues it — Ethereum, Base, Avalanche and Stellar; RLUSD on the XRP Ledger; and the native coin on every chain. On BNB Chain, PipRail also ships FDUSD, USD1 and U. Any other token can be paid by passing its address.',
  },
]

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${canonical}#faq`,
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
}
---

<Layout
  title={pageTitle}
  description={post.description}
  ogImage={post.ogImage}
  ogType="article"
  article={{
    publishedTime: post.published,
    modifiedTime: post.updated ?? post.published,
    author: post.author.name,
    section: post.category,
    tags: post.tags,
  }}
>
  <Fragment slot="head">
    <link rel="author" href={post.author.url} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(articleLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  </Fragment>

  <Navigation />

  <main class="mx-auto max-w-3xl px-4 sm:px-6">
    <div class="pt-6"><Breadcrumbs items={[{ name: 'Blog', href: '/blog' }, { name: post.title }]} /></div>

    <article class="fade-up">
      <header class="pt-10 sm:pt-14">
        <div class="inline-flex items-center gap-1.5 font-mono text-[11px] uppercase tracking-[0.2em] text-accent">
          PipRail · {post.category}
        </div>
        <h1 class="mt-5 text-pretty text-[2.1rem] font-bold leading-[1.12] tracking-tight text-white sm:text-5xl">
          {post.title}
        </h1>
        <p class="mt-5 text-lg leading-relaxed text-neutral-400 sm:text-xl">
          An AI agent should be able to pay with whatever it already holds — on whatever chain that lives on.
          PipRail covers <em class="not-italic text-neutral-200">29 chains from a single parameter</em>. Here is every
          one, the tokens on each, and the design choice that lets it reach chains it has never heard of.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-x-4 gap-y-3 border-y border-white/10 py-4">
          <div class="flex items-center gap-3">
            <span
              class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-accent/30 bg-accent/10 font-display text-sm font-semibold text-accent"
              aria-hidden="true"
            >JW</span>
            <div class="leading-tight">
              <div class="text-sm font-semibold text-neutral-100">{post.author.name}</div>
              <div class="text-xs text-neutral-400">{post.author.role}</div>
            </div>
          </div>
          <div class="ml-auto flex items-center gap-x-4 gap-y-1 text-xs text-neutral-400">
            <span class="inline-flex items-center gap-1.5">
              <CalendarDays size={13} aria-hidden="true" />
              <time datetime={post.published}>{formatDate(post.published)}</time>
            </span>
            <span class="inline-flex items-center gap-1.5">
              <Clock size={13} aria-hidden="true" /> {post.readingTime} min read
            </span>
          </div>
        </div>
      </header>

      <aside class="card mt-10 rounded-2xl p-6 sm:p-7" aria-label="Summary">
        <h2 class="font-mono text-[11px] uppercase tracking-[0.2em] text-accent">The short version</h2>
        <ul class="mt-4 space-y-3">
          {takeaways.map((t) => (
            <li class="flex gap-3 text-[15px] leading-relaxed text-neutral-300">
              <Globe size={17} class="mt-0.5 shrink-0 text-accent" aria-hidden="true" />
              <span set:html={t} />
            </li>
          ))}
        </ul>
      </aside>

      <div class="article-prose mt-10">
        <p>Most payment SDKs answer “which chains do you support?” with a list they maintain — an allowlist, baked into a release, that grows one pull request at a time. PipRail answers it differently: <strong>chain details are data the caller passes, not an allowlist the SDK ships.</strong> The built-in presets are a convenience — each comes with its canonical USDC address already filled in — but they are not a fence. Name a preset, or hand the SDK a chain it has never seen, and it pays either way.</p>

        <p>That is the whole idea behind one parameter. The <span class="font-mono text-[0.9em] text-neutral-200">chain:</span> value you pass selects the network, its sensible RPC default, the native coin, and the right stablecoin addresses — all at once. Going from Base to Solana, or from Polygon to the XRP Ledger, is a one-word change in your code and nothing else.</p>

        <div class="cb"><Code code={codePreset} lang="ts" theme={CODE_THEME} /></div>

        <h2>The 20 EVM mainnets</h2>

        <p>Every major EVM chain is a built-in preset, with its Circle-native USDC pre-filled. If a chain you want is not in this list, you do not wait for us to add it — you pass it as a viem <span class="font-mono text-[0.9em] text-neutral-200">Chain</span> or a bare <span class="font-mono text-[0.9em] text-neutral-200">{'{ id, rpcUrl }'}</span>, and it just works.</p>

        <figure class="article-fig">
          <div class="card rounded-2xl p-6 sm:p-7">
            <div class="fig-eyebrow">Built-in EVM presets</div>
            <div class="flex flex-wrap gap-2">
              {evm.map((c) => (
                <span class="rounded-lg border border-white/12 bg-white/4 px-3 py-1.5 text-sm font-medium text-neutral-200">{c}</span>
              ))}
            </div>
          </div>
          <figcaption class="fig-cap">Twenty EVM mainnets, each with canonical USDC ready to go. Any other EVM chain works by being passed in.</figcaption>
        </figure>

        <h2>The nine non-EVM families</h2>

        <p>This is where breadth stops being a number and starts being an advantage. PipRail does not just speak EVM — it puts the payer’s own wallet on Solana, TON, Tron, NEAR, Sui, Aptos, Algorand, Stellar and the XRP Ledger, each as a self-contained driver that mirrors the others file-for-file. The libraries for these chains are optional peers that load only when you name one, so a pure-EVM install never pays for them.</p>

        <figure class="article-fig">
          <div class="card hidden overflow-hidden rounded-2xl sm:block">
            <table class="ctable w-full border-collapse text-left">
              <thead>
                <tr>
                  <th scope="col" class="ct-fam">Family</th>
                  <th scope="col">Tokens it ships</th>
                  <th scope="col">Scheme</th>
                </tr>
              </thead>
              <tbody>
                {families.map((f) => (
                  <tr>
                    <th scope="row" class="ct-fam">{f.name}</th>
                    <td class="font-mono text-[13px] text-neutral-300">{f.tokens}</td>
                    <td class="text-neutral-400">{f.scheme}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <div class="space-y-3 sm:hidden">
            {families.map((f) => (
              <div class="card rounded-2xl p-5">
                <div class="font-display text-base font-semibold text-white">{f.name}</div>
                <div class="mt-2 font-mono text-[13px] text-accent">{f.tokens}</div>
                <div class="mt-1 text-xs text-neutral-500">{f.scheme}</div>
              </div>
            ))}
          </div>
          <figcaption class="fig-cap">The native coin is a first-class payment asset on every family. Where a stablecoin is absent (no Circle USDC on TON or Tron, for instance) it is because that chain has no Tether- or Circle-native version, not because PipRail left it out.</figcaption>
        </figure>

        <p>A few of these chains have a one-time receive prerequisite, and PipRail is honest about it rather than failing silently: NEAR and Algorand need a one-time token registration on the recipient, Stellar and the XRP Ledger need a trustline and an activated account, and the <span class="font-mono text-[0.9em] text-neutral-200">planPayment()</span> call surfaces exactly that with a <span class="font-mono text-[0.9em] text-neutral-200">RECIPIENT_NOT_READY</span> blocker and a one-line funding hint. Paying with the native coin sidesteps all of it.</p>

        <h2>The tokens, in one rule</h2>

        <p>You do not have to memorize a matrix. The coverage follows a simple rule, and everything else is an address away:</p>

        <figure class="article-fig">
          <div class="card rounded-2xl p-6 sm:p-7">
            <ul class="space-y-3.5">
              <li class="flex gap-3 text-[15px] leading-relaxed text-neutral-300"><Coins size={17} class="mt-0.5 shrink-0 text-accent" aria-hidden="true" /><span><strong class="text-white">USDC</strong> — on almost every chain (Circle-native, pre-filled).</span></li>
              <li class="flex gap-3 text-[15px] leading-relaxed text-neutral-300"><Coins size={17} class="mt-0.5 shrink-0 text-accent" aria-hidden="true" /><span><strong class="text-white">USDT</strong> — on most chains, wherever there is a Tether-native (not bridged) version.</span></li>
              <li class="flex gap-3 text-[15px] leading-relaxed text-neutral-300"><Coins size={17} class="mt-0.5 shrink-0 text-accent" aria-hidden="true" /><span><strong class="text-white">EURC</strong> — on Ethereum, Base, Avalanche and Stellar (every one EIP-3009, so exact-payable).</span></li>
              <li class="flex gap-3 text-[15px] leading-relaxed text-neutral-300"><Coins size={17} class="mt-0.5 shrink-0 text-accent" aria-hidden="true" /><span><strong class="text-white">RLUSD</strong> — on the XRP Ledger. On BNB Chain, also <strong class="text-white">FDUSD</strong>, <strong class="text-white">USD1</strong> and <strong class="text-white">U</strong>.</span></li>
              <li class="flex gap-3 text-[15px] leading-relaxed text-neutral-300"><Coins size={17} class="mt-0.5 shrink-0 text-accent" aria-hidden="true" /><span><strong class="text-white">The native coin</strong> — ETH, SOL, XRP, TRX, NEAR, and so on — a valid payment asset on every family.</span></li>
              <li class="flex gap-3 text-[15px] leading-relaxed text-neutral-300"><Coins size={17} class="mt-0.5 shrink-0 text-accent" aria-hidden="true" /><span><strong class="text-white">Anything else</strong> — by address, on any chain. Every shipped token address is verified on-chain before release.</span></li>
            </ul>
          </div>
          <figcaption class="fig-cap">USDC almost everywhere, the native coin everywhere, and an open door for the rest.</figcaption>
        </figure>

        <h2>Why breadth is the point</h2>

        <p>An agent does not get to choose what it holds when it meets a paywall. It holds what it holds — maybe USDC on Base, maybe SOL on Solana, maybe XRP because that is where its budget lives. A rail that only speaks one chain forces a bridge, a swap, and a wait before the agent can do the one thing it was asked to do: pay and move on. A rail that speaks twenty-nine lets it pay with what it has.</p>

        <p>That is why PipRail treats chains as data and not as a gate. The list above is what ships today, verified address by verified address — but the design is built so the list is never the limit. Name a chain. If we have a preset, you get USDC for free. If we do not, pass it in. Either way, your agent pays.</p>
      </div>

      <div class="mt-12 flex flex-wrap items-center gap-3 border-t border-white/10 pt-6">
        <span class="mr-1 inline-flex items-center gap-1.5 text-xs text-neutral-500"><Share2 size={13} aria-hidden="true" /> Share</span>
        <a
          href={`https://x.com/intent/tweet?text=${encodeURIComponent(post.title + ' — by ' + post.author.name)}&url=${encodeURIComponent(canonical)}&via=piprailhq`}
          class="inline-flex items-center gap-1.5 rounded-lg border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-medium text-neutral-300 transition hover:border-white/20 hover:text-white"
        >
          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path></svg>
          Post on X
        </a>
        <button
          type="button"
          data-copy-link
          data-url={canonical}
          class="inline-flex items-center gap-1.5 rounded-lg border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-medium text-neutral-300 transition hover:border-white/20 hover:text-white"
        >
          <span data-copy-label aria-live="polite">Copy link</span>
        </button>
      </div>
    </article>

    <section class="mt-12 rounded-2xl border border-white/10 bg-white/2.5 p-6 sm:p-7">
      <div class="flex items-start gap-4">
        <span
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-accent/30 bg-accent/10 font-display text-base font-semibold text-accent"
          aria-hidden="true"
        >JW</span>
        <div>
          <div class="text-sm font-semibold text-neutral-100">{post.author.name}</div>
          <div class="text-xs text-neutral-500">{post.author.role}</div>
          <p class="mt-2.5 text-sm leading-relaxed text-neutral-400">
            Building PipRail — the open, neutral, no-fee x402 payment rail for AI agents, across 29 chains.
            Writing about how agents pay, and the trust layer the agent economy still has to build.
          </p>
          <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-xs">
            <a href="/" class="text-accent transition hover:brightness-110">piprail.com</a>
            <a href="https://github.com/piprail" class="text-accent transition hover:brightness-110">github.com/piprail</a>
            <a href="https://x.com/piprailhq" class="text-accent transition hover:brightness-110">@piprailhq</a>
          </div>
        </div>
      </div>
    </section>

    <section class="mt-14" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="text-2xl font-semibold tracking-tight sm:text-3xl">Frequently asked</h2>
      <div class="mt-6 divide-y divide-white/10 border-y border-white/10">
        {faqs.map((f) => (
          <details class="group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 text-[15px] font-medium text-neutral-100 transition hover:text-white">
              <span>{f.q}</span>
              <Plus size={17} class="shrink-0 text-neutral-500 transition group-open:rotate-45" aria-hidden="true" />
            </summary>
            <p class="pb-5 text-[15px] leading-relaxed text-neutral-400">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="mt-14 overflow-hidden rounded-2xl border border-accent/20 bg-accent/6 p-7 text-center sm:p-10">
      <h2 class="text-2xl font-semibold tracking-tight text-white sm:text-3xl">Build on the open rail.</h2>
      <p class="mx-auto mt-3 max-w-xl text-neutral-300">
        PipRail is the open, self-custody x402 rail — no backend, no middleman, no fee. Name a chain, add a wallet,
        get paid across 29 of them.
      </p>
      <div class="mt-7 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href="https://www.npmjs.com/package/@piprail/sdk"
          class="cta-glow inline-flex w-full items-center justify-center gap-2 rounded-xl bg-accent px-6 py-3.5 text-sm font-semibold text-neutral-950 transition hover:brightness-110 sm:w-auto"
        >
          <Package size={16} aria-hidden="true" /> Get the SDK
        </a>
        <a
          href="https://docs.piprail.com/chains/overview/"
          class="inline-flex w-full items-center justify-center gap-2 rounded-xl border border-white/12 bg-white/5 px-6 py-3.5 text-sm font-semibold text-neutral-200 transition hover:border-white/20 sm:w-auto"
        >
          <Layers size={16} aria-hidden="true" /> See every chain
        </a>
        <a
          href="https://github.com/piprail/piprail"
          class="inline-flex w-full items-center justify-center gap-2 rounded-xl border border-white/12 bg-white/5 px-6 py-3.5 text-sm font-semibold text-neutral-200 transition hover:border-white/20 sm:w-auto"
        >
          <Github size={16} aria-hidden="true" /> Star on GitHub
        </a>
      </div>
    </section>

    <section class="mt-14 mb-8">
      {more.length > 0 ? (
        <>
          <h2 class="text-sm font-semibold uppercase tracking-wider text-neutral-500">More writing</h2>
          <div class="mt-4 grid gap-4 sm:grid-cols-2">
            {more.map((p) => (
              <a
                href={`/blog/${p.slug}`}
                class="group rounded-2xl border border-white/10 bg-white/2.5 p-5 transition hover:border-accent/30 hover:bg-white/5"
              >
                <div class="font-mono text-[11px] uppercase tracking-[0.2em] text-accent">{p.category}</div>
                <div class="mt-2 font-display text-lg font-semibold leading-snug text-neutral-100 group-hover:text-white">{p.title}</div>
                <p class="mt-1.5 text-sm leading-relaxed text-neutral-400">{p.excerpt}</p>
              </a>
            ))}
          </div>
        </>
      ) : (
        <a href="/blog" class="inline-flex items-center gap-2 text-sm font-medium text-accent transition hover:brightness-110">
          <ArrowLeft size={15} aria-hidden="true" /> All writing
        </a>
      )}
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .article-prose p {
    margin-block: 0 1.5rem;
    color: oklch(0.86 0.008 260);
    font-size: 1.0625rem;
    line-height: 1.85;
    text-wrap: pretty;
  }
  @media (min-width: 640px) {
    .article-prose p { font-size: 1.1875rem; line-height: 1.85; }
  }
  .article-prose h2 {
    margin-top: 2.75rem;
    margin-bottom: 1.25rem;
    font-family: var(--font-display, inherit);
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.2;
    color: #fff;
    text-wrap: balance;
  }
  @media (min-width: 640px) {
    .article-prose h2 { font-size: 1.9rem; }
  }
  .article-prose a {
    color: var(--color-accent);
    text-decoration: underline;
