    text-wrap: pretty;
  }
  @media (min-width: 640px) {
    .article-prose p { font-size: 1.1875rem; line-height: 1.85; }
  }
  .article-prose a {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-color: oklch(0.78 0.17 162 / 0.35);
    text-underline-offset: 3px;
    transition: text-decoration-color 0.15s ease;
  }
  .article-prose a:hover { text-decoration-color: oklch(0.78 0.17 162 / 0.9); }
  .article-prose strong { color: #fff; font-weight: 600; }
