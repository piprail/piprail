---
import Layout from '../layouts/Layout.astro'
import Navigation from '../components/Navigation.astro'
import Footer from '../components/Footer.astro'
import CodeWindow from '../components/CodeWindow.astro'
import SectionHeading from '../components/SectionHeading.astro'
import Breadcrumbs from '../components/Breadcrumbs.astro'
import IntegrationCard from '../components/IntegrationCard.astro'
import { mcpConfigCode } from '../data/snippets'
import { liveIntegrations, comingSoon } from '../data/integrations'
import { Wallet, ShieldCheck, Terminal, ArrowRight, ChevronDown, Code2, Sparkles, Plug } from 'lucide-astro'

const title = '@piprail/mcp — budget-bound x402 payment wallet for AI agents (Claude, Cursor, Code)'
const description =
  'Hand any MCP client a local, budget-capped payment wallet. Agents autonomously pay x402 URLs across 29 chains — Claude Desktop, Cursor, Claude Code, Windsurf, VS Code, Cline. No backend, no custody, no integration.'

// The seven tools your agent gets — only piprail_pay_request moves money.
const tools = [
  { name: 'piprail_discover', d: 'Find payable x402 APIs on the open indexes.' },
  { name: 'piprail_quote_payment', d: 'Read a URL’s exact price — without paying.' },
  { name: 'piprail_plan_payment', d: 'Check balance, gas + policy across every rail first.' },
  { name: 'piprail_pay_request', d: 'Pay the cheapest affordable rail, return the resource.', pays: true },
  { name: 'piprail_register', d: 'List an endpoint you run so other agents find it.' },
  { name: 'piprail_budget', d: 'Read remaining spend + time leash.' },
  { name: 'piprail_guide', d: 'Read the agent contract (quote → plan → pay).' },
]

// Trimmed to the trust + decision questions (the how-to lives in the docs). Keeps the FAQ schema.
const faqs = [
  { q: 'How does spend budgeting work — can the agent overspend?', a: 'No. PIPRAIL_MAX_AMOUNT caps each individual payment and PIPRAIL_MAX_TOTAL caps lifetime spend per token. Both are enforced by the SDK before any on-chain send, and checked against the token’s true on-chain decimals — so a malicious server can’t slip past a limit by misstating the price. An over-budget request comes back as { declined: true, reason } and nothing moves. You can also restrict tokens (PIPRAIL_TOKENS) and destination hosts (PIPRAIL_HOSTS).' },
  { q: 'Does the MCP take custody of my funds or run a backend?', a: 'No. The server runs locally on your machine with your key, your RPC, and your limits. Payments settle wallet-to-wallet straight to the recipient — PipRail runs no service and holds nothing. There’s no PipRail backend to compromise and no facilitator in the path. The server code is MIT and open; you can audit or run it yourself.' },
  { q: 'Which AI clients and chains does the MCP support?', a: 'Clients: Claude Desktop, Cursor, Claude Code, Windsurf, VS Code, and Cline — any MCP client. Chains: all 29 PipRail supports — 20 EVM mainnets plus Solana, TON, Tron, NEAR, Sui, Aptos, Algorand, Stellar, and the XRP Ledger. EVM works out of the box (the server ships with viem); non-EVM chains pull their SDK peer library on demand. Each server instance is one wallet on one chain — register it once per chain to give an agent several rails.' },
  { q: 'What’s the difference between @piprail/sdk and @piprail/mcp?', a: 'The SDK is for developers who write code — you call requirePayment / createPaymentGate to charge, or PipRailClient to pay, in TypeScript. The MCP flips that: you write no code, you add an env block, and agents in your MCP client pay x402 URLs autonomously, capped by a spend policy. Same engine, same 29 chains, same backendless self-custody — the MCP is the zero-integration path for AI/agent operators.' },
]

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': 'https://piprail.com/mcp#faq',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}
---

<Layout title={title} description={description}>
  <Navigation path="/mcp" />

  <main class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="pt-6"><Breadcrumbs items={[{ name: 'MCP' }]} /></div>

    <!-- Hero -->
    <section class="fade-up py-16 text-center sm:py-20 md:py-24">
      <p class="mb-7 inline-flex items-center gap-2 rounded-full border border-accent/20 bg-accent/8 px-3.5 py-1.5 text-xs font-medium text-accent">
        <Sparkles size={13} aria-hidden="true" /> MCP server · agent payments · 29 chains · local-only
      </p>
      <h1 class="mx-auto max-w-4xl text-[2.5rem] font-semibold leading-[1.05] tracking-tight sm:text-6xl">
        x402 agents, <span class="text-accent">zero integration</span>.
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-base leading-relaxed text-neutral-400 sm:text-lg">
        Hand any MCP client a <span class="text-neutral-200">budget-bound payment wallet</span>. Claude Desktop,
        Cursor, Claude Code, Windsurf, VS Code, and Cline can pay x402-gated URLs on their own — across 29 chains,
        capped by a spend policy the model <span class="text-neutral-200">cannot exceed</span>. No backend, no custody, no code.
      </p>
      <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <div class="flex w-full max-w-xs items-center gap-3 rounded-xl border border-white/10 bg-neutral-900/80 px-5 py-3.5 font-mono text-sm sm:w-auto">
          <span class="select-none text-neutral-600">$</span>
          <span class="truncate">npx -y @piprail/mcp</span>
        </div>
        <a href="https://www.npmjs.com/package/@piprail/mcp" class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-accent px-6 py-3.5 text-sm font-semibold text-neutral-950 transition hover:brightness-110 sm:w-auto">
          @piprail/mcp on npm <ArrowRight size={16} aria-hidden="true" />
        </a>
      </div>
    </section>

    <!-- Quick start -->
    <section class="border-t border-white/10 py-16 sm:py-20">
      <SectionHeading title="Add it in one block.">
        Drop this into your MCP client with your wallet key and a budget. The defaults are deliberately
        small and safe — <span class="text-neutral-200">0.10 per payment, 10.00 lifetime per token, USDC on Base</span>.
      </SectionHeading>
      <div class="grid gap-6 lg:grid-cols-[1.05fr_1fr] lg:items-start">
        <div class="min-w-0">
          <CodeWindow file="claude_desktop_config.json" code={mcpConfigCode} />
          <p class="mt-3 text-sm text-neutral-500">Restart your client — the tools appear.</p>
        </div>
        <div class="rounded-2xl border border-white/10 bg-white/2 p-5">
          <p class="flex items-start gap-2.5 text-sm leading-snug text-neutral-400">
            <ShieldCheck size={16} class="mt-0.5 shrink-0 text-accent" aria-hidden="true" />
            <span><span class="text-neutral-200">Never commit your key.</span> Cursor, Claude Code, Windsurf and VS Code support
            <code class="rounded bg-white/5 px-1 text-neutral-300">{'${env:PIPRAIL_PRIVATE_KEY}'}</code> interpolation — keep it out of the file. Claude Desktop takes the plain value, so treat that config as a secret.</span>
          </p>
          <div class="mt-5 flex flex-wrap gap-2 border-t border-white/10 pt-5">
            <a href="https://docs.piprail.com/mcp/client-setup/" class="inline-flex items-center gap-1.5 rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-[13px] font-medium text-neutral-300 transition hover:border-white/20">Per-client config <ArrowRight size={13} aria-hidden="true" /></a>
            <a href="https://docs.piprail.com/mcp/configuration/" class="inline-flex items-center gap-1.5 rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-[13px] font-medium text-neutral-300 transition hover:border-white/20">Every env var <ArrowRight size={13} aria-hidden="true" /></a>
          </div>
        </div>
      </div>
    </section>

    <!-- The seven tools -->
    <section class="border-t border-white/10 py-16 sm:py-20">
      <SectionHeading title="Seven tools, the moment it connects.">
        A complete, safe payment workflow — <span class="text-neutral-200">discover → quote → plan → pay</span>.
        Only <code class="text-neutral-300">piprail_pay_request</code> moves money; the rest are read-only.
      </SectionHeading>
      <ul class="grid gap-x-8 gap-y-5 sm:grid-cols-2 lg:grid-cols-3">
        {tools.map((t) => (
          <li class="flex items-start gap-3">
            <span class={`mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-md border ${t.pays ? 'border-accent/40 bg-accent/15 text-accent' : 'border-white/10 bg-white/5 text-neutral-400'}`}><Plug size={12} aria-hidden="true" /></span>
            <div class="min-w-0">
              <code class="font-mono text-[13px] font-medium text-neutral-100">{t.name}</code>
              {t.pays && <span class="ml-1.5 align-middle text-[10px] font-semibold uppercase tracking-wider text-accent">pays</span>}
              <p class="mt-1 text-sm leading-snug text-neutral-500">{t.d}</p>
            </div>
          </li>
        ))}
      </ul>
      <p class="mt-8 text-sm text-neutral-500">
        Budget-bound and local-only — the policy is enforced before any send, so the model can’t overspend even if it tries.
        <a href="https://docs.piprail.com/mcp/tools/" class="ml-1 text-accent underline-offset-4 hover:underline">Full tool reference →</a>
      </p>
    </section>

    <!-- Framework integrations -->
    <section id="integrations" class="scroll-mt-24 border-t border-white/10 py-16 sm:py-20">
      <SectionHeading title="Drop it into your framework.">
        First-party integrations wrap this same MCP server — the agent gets all seven tools, budget-bound, with no config wrangling.
      </SectionHeading>
      <!-- live integrations — the same reusable component as the home page (src/components/IntegrationCard.astro) -->
      <div class="space-y-4">
        {liveIntegrations.map((i) => <IntegrationCard {...i} />)}
      </div>

      <!-- roadmap -->
      <div class="mt-4 flex flex-wrap items-center gap-3">
        <span class="text-xs font-semibold uppercase tracking-[0.14em] text-neutral-500">More coming</span>
        {comingSoon.map((n) => (
          <span class="rounded-lg border border-white/10 bg-white/5 px-3 py-1.5 text-sm text-neutral-400">{n}</span>
        ))}
      </div>
      <p class="mt-5 text-sm text-neutral-500">Building on a framework that isn’t here yet? It already works as a raw MCP server. <a href="https://docs.piprail.com/integrations/" class="font-medium text-accent transition hover:underline">All integrations →</a></p>
    </section>

    <!-- Why it's safe -->
    <section class="border-t border-white/10 py-16 sm:py-20">
      <SectionHeading title="Why it's safe.">
        The spend policy is the boundary — and it's enforced where it counts.
      </SectionHeading>
      <div class="grid gap-px overflow-hidden rounded-2xl border border-white/10 bg-white/10 md:grid-cols-3">
        <div class="bg-neutral-950 p-6 sm:p-7">
          <ShieldCheck size={18} class="text-accent" aria-hidden="true" />
          <p class="mt-4 text-lg font-medium text-neutral-100">Caps enforced before any send</p>
          <p class="mt-2 leading-relaxed text-neutral-500">Per-call and lifetime-per-token limits are checked against the token's true on-chain decimals — a server can't understate a price to slip past a cap. Over budget → declined, nothing moves.</p>
        </div>
        <div class="bg-neutral-950 p-6 sm:p-7">
          <Wallet size={18} class="text-accent" aria-hidden="true" />
          <p class="mt-4 text-lg font-medium text-neutral-100">No custody, no backend</p>
          <p class="mt-2 leading-relaxed text-neutral-500">Runs locally with your key, your RPC, your limits. Payments settle wallet-to-wallet — PipRail holds nothing and runs no service. Nothing to compromise.</p>
        </div>
        <div class="bg-neutral-950 p-6 sm:p-7">
          <Code2 size={18} class="text-accent" aria-hidden="true" />
          <p class="mt-4 text-lg font-medium text-neutral-100">Open and auditable</p>
          <p class="mt-2 leading-relaxed text-neutral-500">MIT-licensed and open source — read it, audit it, run it yourself. No key ever leaves your machine.</p>
        </div>
      </div>
      <p class="mt-6 text-sm leading-relaxed text-neutral-500">
        Pay across all 29 chains — 20 EVM mainnets plus Solana, TON, Tron, NEAR, Sui, Aptos, Algorand, Stellar, and
        the XRP Ledger. <a href="/chains" class="text-accent underline-offset-4 hover:underline">See every chain →</a>
      </p>
    </section>

    <!-- FAQ -->
    <section class="border-t border-white/10 py-16 sm:py-20">
      <div class="grid gap-8 lg:grid-cols-[minmax(0,340px)_minmax(0,1fr)] lg:gap-16">
        <div class="lg:sticky lg:top-24 lg:self-start">
          <SectionHeading title="MCP FAQ." class="max-w-sm">
            The trust questions, answered. The setup how-to lives in the <a href="https://docs.piprail.com/mcp/overview/" class="text-accent underline-offset-4 hover:underline">docs</a>.
          </SectionHeading>
        </div>
        <div class="divide-y divide-white/10 overflow-hidden rounded-2xl border border-white/10 bg-neutral-950">
          {faqs.map((f, i) => (
            <details class="group" open={i === 0}>
              <summary class="flex cursor-pointer list-none items-center justify-between gap-5 px-6 py-5 text-[15px] font-medium text-neutral-100 transition hover:bg-white/3 [&::-webkit-details-marker]:hidden sm:px-7">
                <span>{f.q}</span>
                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-white/10 text-neutral-400 transition group-open:border-accent/40 group-open:text-accent">
                  <ChevronDown size={16} class="transition-transform duration-300 group-open:rotate-180" aria-hidden="true" />
                </span>
              </summary>
              <p class="-mt-1 px-6 pb-6 text-sm leading-relaxed text-neutral-400 sm:px-7">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="border-t border-white/10 py-20 text-center sm:py-24">
      <h2 class="mx-auto max-w-2xl text-3xl font-semibold leading-tight tracking-tight sm:text-4xl">
        Give your agent a wallet.
      </h2>
      <p class="mx-auto mt-5 max-w-xl text-base text-neutral-400 sm:text-lg">
        One env block, budget-bound, on every chain that matters.
      </p>
      <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href="https://www.npmjs.com/package/@piprail/mcp" class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-accent px-6 py-3.5 text-sm font-semibold text-neutral-950 transition hover:brightness-110 sm:w-auto">
          <Terminal size={16} aria-hidden="true" /> npm install
        </a>
        <a href="https://github.com/piprail/piprail/tree/main/mcp" class="inline-flex w-full items-center justify-center gap-2 rounded-xl border border-white/10 bg-white/5 px-6 py-3.5 text-sm font-semibold text-neutral-200 transition hover:border-white/20 sm:w-auto">
          GitHub
        </a>
        <a href="https://docs.piprail.com/mcp/overview/" class="inline-flex w-full items-center justify-center gap-2 rounded-xl border border-white/10 bg-white/5 px-6 py-3.5 text-sm font-semibold text-neutral-200 transition hover:border-white/20 sm:w-auto">
          Read the docs
        </a>
      </div>
    </section>
  </main>

  <Footer />

  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqLd)} />
</Layout>
