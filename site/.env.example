# PipRail site — build-time public env vars.
#
# Astro exposes only PUBLIC_*-prefixed vars to the client bundle. EVERY var here is OPTIONAL:
# the site builds and runs identically with none set (each feature renders nothing when unset).
# Set the real values in Netlify → Site settings → Environment variables — never commit them.
# Full playbook: .claude/research/seo-monitoring-setup.md
#
# Copy to .env for local builds:  cp site/.env.example site/.env

# ── Search-console verification (HTML-tag method) ───────────────────────────────
# Google Search Console (URL-prefix property). A working fallback token is already hardcoded in
# Layout.astro, so GSC stays verified even when this is unset; set it only to override.
PUBLIC_GSC_VERIFICATION=

# Bing Webmaster Tools (msvalidate.01). No fallback — Bing verification is DORMANT until this is
# set. Bing matters for AEO: ChatGPT Search + Copilot read the Bing index.
PUBLIC_BING_VERIFICATION=

# ── Web analytics (cookieless, no consent banner; both inert until set) ─────────
# Cloudflare Web Analytics — recommended: free, unlimited, cookieless, no DNS change.
# dash.cloudflare.com → Web Analytics → add piprail.com → copy the token.
PUBLIC_CF_BEACON_TOKEN=

# GoatCounter endpoint (alternative to Cloudflare), e.g. https://piprail.goatcounter.com/count
PUBLIC_GOATCOUNTER_URL=
