---
// Starlight `Head` override — adds JSON-LD to every docs page.
//
// WHY: Starlight ships no structured data at all. Measured 2026-08-27, all 91 pages on
// docs.piprail.com emitted ZERO JSON-LD — 87% of PipRail's indexable surface, invisible
// as machine-readable entities to search and AI answer engines. Since the docs ARE the
// citable asset for a developer product, that was the single biggest AEO gap we had.
//
// The `@id`s below intentionally MATCH the ones piprail.com emits
// (site/src/layouts/Layout.astro), so the apex and the docs subdomain resolve to the SAME
// Organization and WebSite entities rather than two competing ones. Don't rename them on
// one side only. See .claude/skills/structured-data.
import Default from '@astrojs/starlight/components/Head.astro'

const { entry, id, lastUpdated } = Astro.locals.starlightRoute

const SITE = 'https://docs.piprail.com'
const APEX = 'https://piprail.com'

const canonical = new URL(Astro.url.pathname, SITE).href
const title = entry.data.title
const description = entry.data.description ?? ''

// Breadcrumbs from the route id: "accepting-payments/defining-accepts" →
// Docs / Accepting Payments / <page title>.
const titleCase = (s: string) =>
  s.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase())

const segments = id.split('/').filter(Boolean)
const crumbs = [{ name: 'Docs', item: SITE + '/' }]
if (segments.length > 1) {
  crumbs.push({ name: titleCase(segments[0]!), item: `${SITE}/${segments[0]}/` })
}
crumbs.push({ name: title, item: canonical })

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': `${canonical}#breadcrumbs`,
  itemListElement: crumbs.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.name,
    item: c.item,
  })),
}

// TechArticle (not Article) — this is developer documentation, and the more specific
// type is what gives an answer engine the confidence to quote it as a technical source.
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  '@id': `${canonical}#article`,
  headline: title,
  ...(description ? { description } : {}),
  url: canonical,
  inLanguage: 'en',
  isPartOf: { '@id': `${SITE}/#website` },
  publisher: { '@id': `${APEX}/#organization` },
  author: { '@id': `${APEX}/#organization` },
  about: { '@id': `${APEX}/#sdk` },
  proficiencyLevel: 'Beginner',
  ...(lastUpdated ? { dateModified: new Date(lastUpdated).toISOString() } : {}),
  breadcrumb: { '@id': `${canonical}#breadcrumbs` },
}

// Site-wide entities. `@id`s are shared with the apex so the graph unifies.
const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE}/#website`,
  name: 'PipRail Documentation',
  url: SITE + '/',
  inLanguage: 'en',
  publisher: { '@id': `${APEX}/#organization` },
  about: { '@id': `${APEX}/#sdk` },
}

const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${APEX}/#organization`,
  name: 'PipRail',
  url: APEX,
  logo: `${APEX}/logo.png`,
  sameAs: [
    'https://github.com/piprail/piprail',
    'https://www.npmjs.com/package/@piprail/sdk',
    'https://x.com/piprailhq',
  ],
}

const softwareLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  '@id': `${APEX}/#sdk`,
  name: 'PipRail',
  alternateName: '@piprail/sdk',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Node.js, Browser',
  url: APEX,
  downloadUrl: 'https://www.npmjs.com/package/@piprail/sdk',
  codeRepository: 'https://github.com/piprail/piprail',
  programmingLanguage: 'TypeScript',
  license: 'https://opensource.org/licenses/MIT',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
}

const blocks = [articleLd, breadcrumbLd, websiteLd, organizationLd, softwareLd]

// Search Console / Bing verification for the DOCS host.
//
// docs.piprail.com is a SEPARATE property from piprail.com: the apex is verified as a
// URL-prefix property (`https://piprail.com/`), which does NOT cover a subdomain. Without
// this tag the 91 docs pages — 87% of our indexable surface — have no Search Console
// coverage at all: no index reporting, no sitemap submission, no URL inspection.
// Google issues one verification token per account, so this is the same value the apex uses.
const GSC_VERIFICATION =
  import.meta.env.PUBLIC_GSC_VERIFICATION ?? 'LPx85yBDaIQPQ6DJWuub0OcnlZO8ra9nrQCxr5vzH-g'
const BING_VERIFICATION = import.meta.env.PUBLIC_BING_VERIFICATION
---

<Default><slot /></Default>
<meta name="google-site-verification" content={GSC_VERIFICATION} />
{BING_VERIFICATION && <meta name="msvalidate.01" content={BING_VERIFICATION} />}
{
  blocks.map((b) => (
    <script type="application/ld+json" set:html={JSON.stringify(b)} />
  ))
}
