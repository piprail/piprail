---
// Starlight `Head` override: adds JSON-LD to every docs page.
//
// WHY: Starlight ships no structured data at all. Measured 2026-08-27, all 91 pages on
// docs.piprail.com emitted ZERO JSON-LD. That is 87% of PipRail's indexable surface, invisible
// as machine-readable entities to search and AI answer engines. Since the docs ARE the
// citable asset for a developer product, that was the single biggest AEO gap we had.
//
// The `@id`s below intentionally MATCH the ones piprail.com emits
// (site/src/layouts/Layout.astro), so the apex and the docs subdomain resolve to the SAME
// Organization and WebSite entities rather than two competing ones. Don't rename them on
// one side only. See .claude/skills/structured-data.
import Default from '@astrojs/starlight/components/Head.astro'

const { entry, id, lastUpdated } = Astro.locals.starlightRoute

const SITE = 'https://docs.piprail.com'
const APEX = 'https://piprail.com'

const canonical = new URL(Astro.url.pathname, SITE).href
const title = entry.data.title
const description = entry.data.description ?? ''

// Breadcrumbs from the route id: "accepting-payments/defining-accepts" →
// Docs / Accepting Payments / <page title>.
const titleCase = (s: string) =>
  s.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase())

const segments = id.split('/').filter(Boolean)
const crumbs = [{ name: 'Docs', item: SITE + '/' }]
if (segments.length > 1) {
  crumbs.push({ name: titleCase(segments[0]!), item: `${SITE}/${segments[0]}/` })
}
crumbs.push({ name: title, item: canonical })

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': `${canonical}#breadcrumbs`,
  itemListElement: crumbs.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.name,
    item: c.item,
  })),
}

// TechArticle (not Article), because this is developer documentation and the more specific
// type is what gives an answer engine the confidence to quote it as a technical source.
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  '@id': `${canonical}#article`,
  headline: title,
  ...(description ? { description } : {}),
  url: canonical,
  inLanguage: 'en',
  isPartOf: { '@id': `${SITE}/#website` },
  publisher: { '@id': `${APEX}/#organization` },
  author: { '@id': `${APEX}/#organization` },
  about: { '@id': `${APEX}/#sdk` },
  proficiencyLevel: 'Beginner',
  ...(lastUpdated ? { dateModified: new Date(lastUpdated).toISOString() } : {}),
  breadcrumb: { '@id': `${canonical}#breadcrumbs` },
}

// Site-wide entities. `@id`s are shared with the apex so the graph unifies.
const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE}/#website`,
  name: 'PipRail Documentation',
  url: SITE + '/',
  inLanguage: 'en',
  publisher: { '@id': `${APEX}/#organization` },
  about: { '@id': `${APEX}/#sdk` },
}

const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${APEX}/#organization`,
  name: 'PipRail',
  url: APEX,
  logo: `${APEX}/logo.png`,
  sameAs: [
    'https://github.com/piprail/piprail',
    'https://www.npmjs.com/package/@piprail/sdk',
    'https://x.com/piprailhq',
    // 🔴 The VANITY form, never the numeric one LinkedIn hands you at creation:
    // logged out that serves a sign-in wall at HTTP 200, and every crawler reading
    // this node is logged out. Guarded by the `sameas-mirrors` sync rule.
    'https://www.linkedin.com/company/piprail',
  ],
}

const softwareLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  '@id': `${APEX}/#sdk`,
  name: 'PipRail',
  alternateName: '@piprail/sdk',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Node.js, Browser',
  url: APEX,
  downloadUrl: 'https://www.npmjs.com/package/@piprail/sdk',
  codeRepository: 'https://github.com/piprail/piprail',
  programmingLanguage: 'TypeScript',
  license: 'https://opensource.org/licenses/MIT',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
}

const blocks = [articleLd, breadcrumbLd, websiteLd, organizationLd, softwareLd]

// Search Console / Bing verification for the DOCS host.
//
// docs.piprail.com is a SEPARATE property from piprail.com: the apex is verified as a
// URL-prefix property (`https://piprail.com/`), which does NOT cover a subdomain. Without
// this tag the 91 docs pages, 87% of our indexable surface, have no Search Console
// coverage at all: no index reporting, no sitemap submission, no URL inspection.
// Google issues one verification token per account, so this is the same value the apex uses.
const GSC_VERIFICATION =
  import.meta.env.PUBLIC_GSC_VERIFICATION ?? 'LPx85yBDaIQPQ6DJWuub0OcnlZO8ra9nrQCxr5vzH-g'
// Bing's verification code is account-wide (one code covers every site on the
// Webmaster account), so this is the same value the sister sites use. Bing matters
// more than its market share suggests: ChatGPT search and Copilot run on the Bing index.
const BING_VERIFICATION =
  import.meta.env.PUBLIC_BING_VERIFICATION ?? '4C2A94BD8695D97BC9033E2A6E5002D5'

// GA4, on the docs stream of the SAME property as piprail.com (properties/551957171),
// so apex and docs traffic unify in one report instead of two disconnected ones.
// Deferred + bot-gated exactly like the apex; see site/src/components/Analytics.astro
// for the full reasoning.
const GA_ID = import.meta.env.PUBLIC_GA_MEASUREMENT_ID ?? 'G-VRMS0WPNC0'
---

<Default><slot /></Default>
<meta name="google-site-verification" content={GSC_VERIFICATION} />
{BING_VERIFICATION && <meta name="msvalidate.01" content={BING_VERIFICATION} />}
{GA_ID && (
  <script is:inline define:vars={{ GA_ID }}>
    {`(function () {
  try {
    var q = location.search;
    if (q.indexOf('ga_optout=') !== -1) {
      q.indexOf('ga_optout=1') !== -1
        ? localStorage.setItem('pr_ga_optout', '1')
        : localStorage.removeItem('pr_ga_optout');
    }
    if (localStorage.getItem('pr_ga_optout') === '1') return;
  } catch (e) {}
  if (navigator.webdriver) return;
  window.dataLayer = window.dataLayer || [];
  function gtag(){ dataLayer.push(arguments); }
  window.gtag = gtag;
  gtag('js', new Date());
  gtag('config', GA_ID, { transport_type: 'beacon' });
  function load() {
    if (window.__gaLoaded) return;
    window.__gaLoaded = true;
    var s = document.createElement('script');
    s.async = true;
    s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
    document.head.appendChild(s);
  }
  ['pointerdown','keydown','scroll','touchstart'].forEach(function (e) {
    addEventListener(e, load, { once: true, passive: true });
  });
  if ('requestIdleCallback' in window) requestIdleCallback(load, { timeout: 3500 });
  else setTimeout(load, 3500);
})();`}
  </script>
)}
{
  blocks.map((b) => (
    <script type="application/ld+json" set:html={JSON.stringify(b)} />
  ))
}
